<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>loukupm</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>LookUp</ApplicationTitle>
		<ApplicationId>com.master-code.it.loukupm</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">16.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">14.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<NeutralLanguage>de-DE</NeutralLanguage>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<AndroidUseAapt2>True</AndroidUseAapt2>
		<AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
		<MultiDexEnabled>true</MultiDexEnabled>
		<AndroidDexTool>d8</AndroidDexTool>
		<AndroidKeyStore>True</AndroidKeyStore>
		<AndroidSigningKeyStore>$(LocalAppData)\Xamarin\Mono for Android\debug.keystore</AndroidSigningKeyStore>
		<AndroidSigningStorePass>android</AndroidSigningStorePass>
		<AndroidSigningKeyAlias>androiddebugkey</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>android</AndroidSigningKeyPass>
		<AndroidSupportedAbis>armeabi-v7a;arm64-v8a;x86;x86_64</AndroidSupportedAbis>
		<DebugSymbols>False</DebugSymbols>
		<RunAOTCompilation>False</RunAOTCompilation>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android|AnyCPU'">
		<AndroidUseAapt2>True</AndroidUseAapt2>
		<AndroidCreatePackagePerAbi>False</AndroidCreatePackagePerAbi>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<MultiDexEnabled>true</MultiDexEnabled>
		<AndroidDexTool>d8</AndroidDexTool>
		<DebugSymbols>True</DebugSymbols>
		<RunAOTCompilation>False</RunAOTCompilation>
		
	</PropertyGroup>

	<PropertyGroup>
		<ResizetizerMaxDegreeOfParallelism>1</ResizetizerMaxDegreeOfParallelism>
	</PropertyGroup>

	<ItemGroup>
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		<MauiImage Update="Resources\Images\flag_de.svg" Resize="True" BaseSize="60,40" />
		<MauiImage Update="Resources\Images\flag_ar.svg" Resize="True" BaseSize="60,40" />
		<MauiImage Update="Resources\Images\chevron_gold.svg" Resize="True" BaseSize="24,24" />
		<MauiImage Update="Resources\Images\password_reset_success.svg" Resize="True" BaseSize="200,200" />
		<MauiImage Update="Resources\Images\password_reset_failed.svg" Resize="True" BaseSize="200,200" />
		<MauiImage Update="Resources\Images\otp_incorrect.svg" Resize="True" BaseSize="200,200" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<None Remove="Resources\Splash\mmm.svg" />
		<None Remove="Resources\Splash\mmm.png" />

		<!-- Reference TrimmerRootDescriptor for IL trimming preservation -->
		<TrimmerRootDescriptor Include="TrimmerRootDescriptor.xml" />

		<MauiAsset Include="appsettings.json" LogicalName="appsettings.json" />
	</ItemGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="#000000" />
	</ItemGroup>

	<ItemGroup>
	
		<MauiSplashScreen Include="Resources\Splash\splash_logo.png" Color="#000000" BaseSize="128,128" />
	</ItemGroup>


	<ItemGroup>
		<!-- إجبار المشروع على استخدام إصدار ماوي المتوافق مع UraniumUI 3.0.0 -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.71" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.71" />

		<PackageReference Include="CommunityToolkit.Maui" Version="8.0.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="FFImageLoading.Maui" Version="1.3.2" />
		<PackageReference Include="FirebaseAuthentication.net" Version="4.1.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.5" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
		<PackageReference Include="OneSignalSDK.DotNet" Version="5.2.2" />
		<PackageReference Include="Sharpnado.HorusSkeleton.Maui" Version="2.0.0" />
		<PackageReference Include="The49.Maui.BottomSheet" Version="8.0.3" />
		<PackageReference Include="UraniumUI.Material" Version="3.0.0" />
		<PackageReference Include="UraniumUI.Blurs" Version="3.0.0" />
		<PackageReference Include="UraniumUI.Icons.MaterialIcons" Version="3.0.0" />
		<PackageReference Include="UraniumUI.Icons.MaterialSymbols" Version="3.0.0" />
		<PackageReference Include="UraniumUI.Validations.DataAnnotations" Version="3.0.0" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.AndroidX.Credentials" Version="1.6.0.1" />
		<PackageReference Include="Xamarin.AndroidX.Credentials.PlayServicesAuth" Version="1.6.0.2" />
		<PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.9.0" />
		<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
		<PackageReference Include="Xamarin.GoogleAndroid.Libraries.Identity.GoogleId" Version="1.1.0.13" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Langue\AppResource.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>AppResource.resx</DependentUpon>
		</Compile>
		<Compile Update="View\BottomShee.xaml.cs">
			<DependentUpon>BottomShee.xaml</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Langue\AppResource.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>AppResource.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Update="View\*\.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="View\Areyousuredeletyouraccountpage.xaml">
