<Shell
    x:Class="loukupm.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:loukupm"
    xmlns:view="clr-namespace:loukupm.View"
    xmlns:Loc="clr-namespace:loukupm.Langue"
    Shell.FlyoutBehavior="Flyout"
    Shell.BackgroundColor="#151821"
    Shell.TabBarTitleColor="#A8883C"
    Shell.TabBarUnselectedColor="Gray"
    Shell.TabBarDisabledColor="#151821"
    Shell.TabBarBackgroundColor="#151821"
    Shell.TabBarForegroundColor="#A8883C"
    Shell.FlyoutBackgroundColor="#121416"
    Shell.UnselectedColor="Black"
    Shell.DisabledColor="Black"
    Title="loukupm">

    
    <Shell.ItemTemplate>
        
        <DataTemplate>
            <!-- Grid layout with icon + label -->
            <Grid ColumnDefinitions="Auto,*" 
                  ColumnSpacing="15" 
                  Padding="20,12" 
                  BackgroundColor="Transparent"
                  VerticalOptions="Center">

                <!-- Column 0: Icon -->
                <Image Grid.Column="0"
                       Source="{Binding Icon}"
                       WidthRequest="30"
                       HeightRequest="30"
                       Aspect="AspectFit"
                       Opacity="0.9"
                       VerticalOptions="Center" />

                <!-- Column 1: Title/Label -->
                <Label Grid.Column="1"
                       Text="{Binding Title}"
                       FontSize="14"
                       FontFamily="Oswald"
                       TextColor="White"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"
                       MaxLines="1" />
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>
    <Shell.MenuItemTemplate>
        <DataTemplate>
            <Grid Padding="10,5">
                <Label Text="{Binding Text}"
           TextColor="#555"
           FontSize="12"
           HorizontalOptions="Start" />
            </Grid>
        </DataTemplate>
    </Shell.MenuItemTemplate>

    <Shell.FlyoutHeader>
        <!-- قمنا بتغيير الخلفية إلى لون رمادي داكن متناسق وحذفنا المارجن لملء الفراغات الصفراء -->
        <Grid
            BackgroundColor="#151515"
            RowDefinitions="Auto"
            ColumnDefinitions="Auto,*,Auto"
            Padding="20,25,20,20"
            ColumnSpacing="15"
            RowSpacing="5">

            <!-- User Avatar -->
            <Frame Grid.Column="0"
                   HeightRequest="80"
                   WidthRequest="80"
                   CornerRadius="40"
                   Padding="0"
                   IsClippedToBounds="True"
                   BackgroundColor="Transparent"
                   BorderColor="Transparent"
                   HasShadow="False"
                   HorizontalOptions="Start"
                   VerticalOptions="Center">

                <Image Source="{Binding Avatar}"
                       Aspect="AspectFill"/>
            </Frame>

            <!-- User Info -->
            <VerticalStackLayout Grid.Column="1"
                                 Spacing="4"
                                 VerticalOptions="Center">

                <Label Text="{Binding UserName}"
                       FontSize="24"
                       FontAttributes="Bold"
                       FontFamily="Oswald"
                       TextColor="White"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"/>

                <Label Text="{Loc:Translate Name=wellomeonlookup}"
                       FontSize="13"
                       FontFamily="Oswald"
                       TextColor="#999999"
                       LineBreakMode="TailTruncation"
                       MaxLines="1"/>
            </VerticalStackLayout>

        </Grid>
    </Shell.FlyoutHeader>

    <ShellContent Route="MainPage"
                  ContentTemplate="{DataTemplate local:MainPage}"
                  IsVisible="False" />

    <ShellContent Route="LoginPage"
                  ContentTemplate="{DataTemplate view:LoginPage}"
                  IsVisible="False" />
    <ShellContent Route="SinginPage"
                  ContentTemplate="{DataTemplate view:SinginPage}"
                  IsVisible="False" />
    <ShellContent Route="PolicyandPrivacyPageatAthun"
              ContentTemplate="{DataTemplate view:PolicyandPrivacyPageatAthun}"
              IsVisible="False" />
    <ShellContent Route="TermsAndConditionsAthun"
           ContentTemplate="{DataTemplate view:TermsAndConditionsAthun}"
           IsVisible="False" />

    <ShellContent Route="NotifictionPage"
                  ContentTemplate="{DataTemplate view:NotifictionPage}"
                  IsVisible="False" />

    
    <TabBar>
        
        <ShellContent
            Icon="nhome.png"
            Title="{Loc:Translate Name=HomePage}"
            ContentTemplate="{DataTemplate view:HomePage}"
            Route="HomePage" />
        <ShellContent
            Icon="nbarber.png"
            Title="{Loc:Translate Name=ServicesPage}"
            ContentTemplate="{DataTemplate view:ServicesPage}"
            Route="ServicesPage" />
        <ShellContent
            Icon="calendar.png"
            Title="{Loc:Translate Name=BookingPage}"
            ContentTemplate="{DataTemplate view:BookingPage}"
            Route="BookingPage" />
        <ShellContent
            Icon="nprofil.png"
            Title="{Loc:Translate Name=ProfilePage
            }"
            ContentTemplate="{DataTemplate view:ProfilePage}"
            Route="ProfilePage" />
    </TabBar>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- MAIN CONTENT SECTION -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <MenuFlyoutItem Text="──────────────────────────" IsEnabled="False"  />
    <MenuFlyoutItem Text="{Loc:Translate Name=general}" IsEnabled="False"  />

    <FlyoutItem Title="{Loc:Translate Name=aboutusga}" Icon="uboutusy.svg">
        <ShellContent
            ContentTemplate="{DataTemplate view:AboutUS}"
            Route="AboutUS" />
    </FlyoutItem>
    <FlyoutItem Title="{Loc:Translate Name=Callmy}" Icon="callme.svg">
        <ShellContent
      ContentTemplate="{DataTemplate view:ContenUs}"
      Route="ContenUs" />
    </FlyoutItem>
    <FlyoutItem Title="{Loc:Translate Name=setting}" Icon="sittingy.svg">
        <ShellContent
        ContentTemplate="{DataTemplate view:SettingPage}"
        Route="SettingPage" />
    </FlyoutItem>
    <MenuFlyoutItem Text="──────────────────────────" IsEnabled="False"  />
    <MenuFlyoutItem Text="{Loc:Translate Name=Legal}" IsEnabled="False"  />
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- SECTION DIVIDER -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
 

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- SUPPORT & LEGAL SECTION -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <FlyoutItem Title="{Loc:Translate Name=PolicyandPrivacy}" Icon="privacyolicyy.svg">
        <ShellContent
            ContentTemplate="{DataTemplate view:PolicyandPrivacyPage}"
            Route="PolicyandPrivacyPage" />
    </FlyoutItem>


    <FlyoutItem Title="{Loc:Translate Name=TermsandConditions}" Icon="termy.svg">
        <ShellContent
            ContentTemplate="{DataTemplate view:TermsAndConditions}"
            Route="TermsAndConditions" />
    </FlyoutItem>

    <FlyoutItem Title="Impressum" Icon="infoy.svg">
        <ShellContent
            ContentTemplate="{DataTemplate view:ImpressumPage}"
            Route="ImpressumPage" />
    </FlyoutItem>

    <MenuFlyoutItem Text="──────────────────────────" IsEnabled="False" />
    <MenuFlyoutItem Text="{Loc:Translate Name=other}" IsEnabled="False"  />


    <MenuItem Command="{Binding LogoutCommand}">
        <Shell.MenuItemTemplate>
            <DataTemplate>
                <!-- حاوية أفقية لترتيب الأيقونة والنص بشكل متناسق ومطابق للـ FlyoutItem -->
                <HorizontalStackLayout Padding="15, 12" Spacing="20" VerticalOptions="Center">

                    <!-- الأيقونة بدقتها الأصلية -->
                    <Image Source="logouty.svg"
                       WidthRequest="24"
                       HeightRequest="24"
                       VerticalOptions="Center" />

                    <!-- النص بلون أبيض ناصع وحجم متناسق -->
                    <Label Text="Logout"
                       TextColor="White"
                       FontSize="16"
                       FontFamily="Oswald"
                       VerticalOptions="Center" />

                </HorizontalStackLayout>
            </DataTemplate>
        </Shell.MenuItemTemplate>
    </MenuItem>
    <MenuFlyoutItem Text="──────────────────────────" IsEnabled="False"/>
        <!-- Deep link routes for Stripe Checkout -->
    <ShellContent Route="checkout/success"
                  ContentTemplate="{DataTemplate view:HomePage}"
                  IsVisible="False" />
    <ShellContent Route="checkout/cancel"
                  ContentTemplate="{DataTemplate view:HomePage}"
                  IsVisible="False" />


</Shell>