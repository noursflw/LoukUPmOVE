<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="loukupm.View.TermsAndConditions"
             BackgroundImageSource="baackgroundpage.png"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             xmlns:loc="clr-namespace:loukupm.Langue"
             xmlns:sk="clr-namespace:Maui.Skeleton;assembly=Sharpnado.HorusSkeleton.Maui"
             Title="{loc:Translate Name=TermsandConditions}">

    <ScrollView BackgroundColor="#252525">
        <VerticalStackLayout Padding="0" Spacing="0">
            
            <!-- Header -->
            <Frame BackgroundColor="#202020"
                   BorderColor="Transparent"
                   CornerRadius="0"
                   Padding="20"
                   Margin="0">
                <Label Text="{loc:Translate Name=TermsandConditions}"
                       HorizontalOptions="Center"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#EBD750" />
            </Frame>

            <!-- Main Content -->
            <VerticalStackLayout Padding="20" Spacing="15">

                <!-- Introduction Section -->
                <Frame BorderColor="#444444"
                       BackgroundColor="#2A2A2A"
                       CornerRadius="16"
                       Padding="15"
                       HasShadow="True">
                    <Label Text="{loc:Translate Name=TermsIntroduction}"
                           FontSize="14"
                           TextColor="White"
                           LineBreakMode="WordWrap" />
                </Frame>

                <!-- 1. App Usage -->
                <Frame BorderColor="#444444"
                       BackgroundColor="#2A2A2A"
                       CornerRadius="16"
                       Padding="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{loc:Translate Name=TermsAppUsage}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#EBD750" />
                        <Label Text="{loc:Translate Name=TermsAppUsageDesc}"
                               FontSize="14"
                               TextColor="#D3D3D3"
                               FontAttributes="Bold" />
                        <Label Text="{loc:Translate Name=TermsAppUsageAgreement}"
                               FontSize="14"
                               TextColor="#D3D3D3"
                               FontAttributes="Bold" />
                        <Label Text="{loc:Translate Name=TermsProvideCorrectInfo}" FontSize="13" TextColor="White" />
                        <Label Text="{loc:Translate Name=TermsUseLegalWay}" FontSize="13" TextColor="White" />
                        <Label Text="{loc:Translate Name=TermsNoHacking}" FontSize="13" TextColor="White" />
                    </VerticalStackLayout>
                </Frame>

                <!-- 2. Accounts -->
                <Frame BorderColor="#444444"
                       BackgroundColor="#2A2A2A"
                       CornerRadius="16"
                       Padding="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{loc:Translate Name=TermsAccounts}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#EBD750" />
                        <Label Text="{loc:Translate Name=TermsAccountResponsibility}"
                               FontSize="14"
                               TextColor="#D3D3D3"
                               FontAttributes="Bold" />
                        <Label Text="{loc:Translate Name=TermsKeepPassword}" FontSize="13" TextColor="White" />
                        <Label Text="{loc:Translate Name=TermsAccountActivities}" FontSize="13" TextColor="White" />
                        <Label Text="{loc:Translate Name=TermsAccountSuspend}"
                               FontSize="14"
                               TextColor="#D3D3D3"
                               FontAttributes="Bold"
                               Margin="0,10,0,0" />
                        <Label Text="{loc:Translate Name=TermsAbusiveUse}" FontSize="13" TextColor="White" />
                        <Label Text="{loc:Translate Name=TermsViolateTerms}" FontSize="13" TextColor="White" />
                    </VerticalStackLayout>
                </Frame>

                <!-- 3. Bookings -->
                <Frame BorderColor="#444444"
                       BackgroundColor="#2A2A2A"
                       CornerRadius="16"
                       Padding="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{loc:Translate Name=TermsBookings}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#EBD750" />
                        <Label Text="{loc:Translate Name=TermsBookingCommitment}"
                               FontSize="14"
                               TextColor="#D3D3D3"
                               FontAttributes="Bold" />
                        <Label Text="{loc:Translate Name=TermsAttendOnTime}" FontSize="13" TextColor="White" />
                        <Label Text="{loc:Translate Name=TermsLateCancel}" FontSize="13" TextColor="White" />
                    </VerticalStackLayout>
                </Frame>

                <!-- 4. Payment -->
                <Frame BorderColor="#444444"
                       BackgroundColor="#2A2A2A"
                       CornerRadius="16"
                       Padding="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{loc:Translate Name=TermsPayment}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#EBD750" />
                        <Label Text="{loc:Translate Name=TermsNoOnlinePayment}"
                               FontSize="14"
                               TextColor="#FFD700"
                               FontAttributes="Bold" />
                        <Label Text="{loc:Translate Name=TermsCashPayment}" FontSize="13" TextColor="White" />
                    </VerticalStackLayout>
                </Frame>

                <!-- 5. Cancellation -->
                <Frame BorderColor="#444444"
                       BackgroundColor="#2A2A2A"
                       CornerRadius="16"
                       Padding="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{loc:Translate Name=TermsCancellation}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#EBD750" />
                        <Label Text="{loc:Translate Name=TermsCancelBooking}" FontSize="13" TextColor="White" />
                    </VerticalStackLayout>
                </Frame>

                <!-- 6. Service Responsibility -->
                <Frame BorderColor="#444444"
                       BackgroundColor="#2A2A2A"
                       CornerRadius="16"
                       Padding="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{loc:Translate Name=TermsServiceResponsibility}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#EBD750" />
                        <Label Text="{loc:Translate Name=TermsPlatformOnly}"
                               FontSize="14"
                               TextColor="#D3D3D3"
                               FontAttributes="Bold" />
                        <Label Text="{loc:Translate Name=TermsNotResponsible}"
                               FontSize="14"
                               TextColor="#D3D3D3"
                               FontAttributes="Bold" />
                        <Label Text="{loc:Translate Name=TermsQualityOfService}" FontSize="13" TextColor="White" />
                        <Label Text="{loc:Translate Name=TermsUserDispute}" FontSize="13" TextColor="White" />
                    </VerticalStackLayout>
                </Frame>

                <!-- 7. Availability -->
                <Frame BorderColor="#444444"
                       BackgroundColor="#2A2A2A"
                       CornerRadius="16"
                       Padding="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{loc:Translate Name=TermsAvailability}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#EBD750" />
                        <Label Text="{loc:Translate Name=TermsAvailabilityEffort}"
                               FontSize="14"
                               TextColor="#D3D3D3"
                               FontAttributes="Bold" />
                        <Label Text="{loc:Translate Name=TermsNoTechnicalIssues}" FontSize="13" TextColor="White" />
                        <Label Text="{loc:Translate Name=TermsNoFullGuarantee}" FontSize="13" TextColor="White" />
                    </VerticalStackLayout>
                </Frame>

                <!-- 8. Account Termination -->
                <Frame BorderColor="#444444"
                       BackgroundColor="#2A2A2A"
                       CornerRadius="16"
                       Padding="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{loc:Translate Name=TermsAccountTermination}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#EBD750" />
                        <Label Text="{loc:Translate Name=TermsUserCanDelete}" FontSize="13" TextColor="White" />
                        <Label Text="{loc:Translate Name=TermsAdminCanTerminate}" FontSize="13" TextColor="White" />
                    </VerticalStackLayout>
                </Frame>

                <!-- 9. Modifications -->
                <Frame BorderColor="#444444"
                       BackgroundColor="#2A2A2A"
                       CornerRadius="16"
                       Padding="15"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{loc:Translate Name=TermsModifications}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#EBD750" />
                        <Label Text="{loc:Translate Name=TermsCanModify}" FontSize="13" TextColor="White" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Last Update -->
                <Frame BorderColor="#FFD700"
                       BackgroundColor="#3A3A2A"
                       CornerRadius="16"
                       Padding="15"
                       Margin="0,10,0,20"
                       HasShadow="True">
                    <Label Text="{loc:Translate Name=TermsLastUpdateTerms}"
                           HorizontalOptions="Center"
                           FontSize="14"
                           TextColor="#FFD700"
                           FontAttributes="Bold" />
                </Frame>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>