                <VerticalStackLayout Spacing="10">
                    <Frame HeightRequest="122" Margin="20,10,20,0"
                           WidthRequest="350"
                           CornerRadius="16" 
                           BackgroundColor="#444444"
                           sk:Skeleton.IsBusy="{Binding IsCatogory}" 
                           sk:Skeleton.Animation="{sk:DefaultAnimation Fade}" 
                           BorderColor="#444444"
                           IsVisible="{Binding IsCatogory}" />

