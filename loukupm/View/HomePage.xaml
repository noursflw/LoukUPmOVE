<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="loukupm.View.HomePage" 
             xmlns:converters="clr-namespace:loukupm.Converter"
             xmlns:sk="clr-namespace:Maui.Skeleton;assembly=Sharpnado.HorusSkeleton.Maui"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:Loc="clr-namespace:loukupm.Langue"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="True"       
             FlowDirection="LeftToRight"      
             Title=" "
             xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             xmlns:vm="clr-namespace:loukupm.ViewModel"
             BackgroundColor="#0A0A0A">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">

            <!-- اليسار -->
            <HorizontalStackLayout 
        Grid.Column="0"
        Spacing="5"
         
        IsVisible="{Binding IsLoadUser, Converter={StaticResource InverseBoolConverter}}">

                <ImageButton 
            CornerRadius="30"
            HeightRequest="50" 
            WidthRequest="50" 
                   
            Clicked="OnFlyoutMenuClicked"
            Source="ic_menu.svg"
            Padding="5"/>
                <VerticalStackLayout>
                    <HorizontalStackLayout>

                        <Label Margin="5,10,0,0"
                                 FontSize="18"
                                 FontFamily="Oswald"
                                 TextColor="White"
                                  Text="{Loc:Translate Name=Wellcom}"/>

                        <Label Text="{Binding UserName}"
                               Margin="5,10,0,0"
                               FontSize="18"
                               FontFamily="Oswald"
                               TextColor="White"/>
                    </HorizontalStackLayout>
                    <Label  Margin="0,0,0,3" Text="{Loc:Translate Name=nicetommetyou}" TextColor="#999999" />
                </VerticalStackLayout>

               
            </HorizontalStackLayout>

            <!-- Skeleton -->
            <Frame 
        HeightRequest="10"
        Margin="20,0,0,0"
        WidthRequest="120"
        CornerRadius="3"
        BackgroundColor="#444444"
        BorderColor="#444444"
        sk:Skeleton.IsBusy="{Binding IsLoadUser}"
        IsVisible="{Binding IsLoadUser}"
        sk:Skeleton.Animation="{sk:DefaultAnimation Fade}"/>

            <!-- Spacer -->
            <BoxView Grid.Column="1" BackgroundColor="#0A0A0A" />

            <!-- اليمين -->
            <HorizontalStackLayout Grid.Column="2" Margin="0,0,20,0">
                <ImageButton 
            CornerRadius="30"
            HeightRequest="40" 
            WidthRequest="40" 
                  
            Clicked="Button_Clicked" 
            Source="nn1.png"/>
            </HorizontalStackLayout>

        </Grid>
        <ScrollView Grid.Row="1" Margin="0,0,0,40">
            <VerticalStackLayout>
              
                
               
                <CarouselView HeightRequest="150" 
                              Margin="0,15,0,0"
                              PeekAreaInsets="0"
                              Loop="True"
                              IsSwipeEnabled="True"
                              HorizontalOptions="Fill"
                              FlowDirection="LeftToRight">
                    <CarouselView.ItemsSource>
                        <x:Array Type="{x:Type ImageSource}">
                            <FileImageSource File="macn1.jpg"/>
                            <FileImageSource File="macan2.jpg"/>
                            <FileImageSource File="macan3.jpg"/>
                            <FileImageSource File="m1.jpg"/>
                            <FileImageSource File="m2.jpg"/>
                            <FileImageSource File="m3.jpg"/>
                        </x:Array>
                    </CarouselView.ItemsSource>

                    <CarouselView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="0"
                                   Margin="20,0,20,0"
                                   HasShadow="True"
                                   CornerRadius="18"
                                   HeightRequest="150"
                                   BackgroundColor="#1A1A1A"
                                   BorderColor="Transparent"
                                   FlowDirection="LeftToRight">
                                <Grid ColumnDefinitions="*,*"
                                      FlowDirection="LeftToRight">

                                 
                                    <Image Grid.Column="0" 
                                           Grid.ColumnSpan="2"
                                           Source="{Binding .}"
                                           Aspect="AspectFill"
                                           ZIndex="0"
                                           FlowDirection="LeftToRight"/>

                                 
                                    <BoxView Grid.Column="0"
                                             Grid.ColumnSpan="2"
                                             ZIndex="1"
                                             FlowDirection="LeftToRight">
                                        <BoxView.Background>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#F2000000" Offset="0"/>
                                                <GradientStop Color="#F2000000" Offset="0.2"/>
                                                <GradientStop Color="#F2000000" Offset="0.3"/>
                                                <GradientStop Color="#F2000000" Offset="0.4"/>
                                                <GradientStop Color="#B3000000" Offset="0.7"/>
                                                <GradientStop Color="#00000000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </BoxView.Background>
                                    </BoxView>

                                   
                                    
                                    <VerticalStackLayout Grid.Column="0"
                                                         Padding="20"
                                                         Spacing="4"
                                                         VerticalOptions="Center"
                                                         HorizontalOptions="Start"
                                                         MaximumWidthRequest="140"
                                                         ZIndex="2">

                                        <Label Text="{Loc:Translate Name=thisstyle}"
                                               TextColor="White"
                                               FontSize="18"
                                               FontFamily="Oswald"
                                               FontAttributes="Bold"
                                               LineBreakMode="NoWrap"/>

                                        <Label Text="{Loc:Translate Name=startuphere}"
                                               TextColor="#f5b713"
                                               FontSize="22"
                                               FontFamily="Oswald"
                                               FontAttributes="Bold"
                                               LineBreakMode="WordWrap"
                                               Margin="0,-2,0,2"/>

                                        <Label Text="{Loc:Translate Name=chosessevvesandbegin}"
                                               TextColor="#AAAAAA"
                                               FontSize="11"
                                               FontFamily="Segoe UI"
                                               LineBreakMode="WordWrap"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>
                <material:TextField FlowDirection="LeftToRight" Margin="25,10,25,0" InputBackgroundColor="#1C1F24" InputTransparent="False" CornerRadius="16" Icon="search.svg" Title="search"  Text="{Binding SearchServiceTerm}" />
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{ Loc:Translate Name=chosesservies}"  FontFamily="georgia" TextColor="White" FontSize="24" Margin="15" HorizontalOptions="Start" />
                    <Label 
                        Margin="10,10,15,0" Grid.Column="1" Text="{ Loc:Translate Name=AllServies}"   FontSize="14" TextColor="#B8963F" FontFamily="Oswald"   TextDecorations="Underline" HorizontalOptions="End">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                        </Label.GestureRecognizers>

                    </Label>

                </Grid>
                <CollectionView 
                   ItemsSource="{Binding FilteredServices}" 
                   Margin="16,0,16,0"
                   IsVisible="{Binding IsServicesLoad, Converter={StaticResource InverseBoolConverter}}">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout  
                           Orientation="Vertical" 
                           HorizontalItemSpacing="12"
                           VerticalItemSpacing="12"
                           Span="2" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- Horizontal Card Frame -->
                            <Frame 
                               Padding="0"
                               CornerRadius="10"
                               BorderColor="#111111"
                               HasShadow="False"
                               HeightRequest="60"
                               Margin="0,0,0,0">

                                <!-- Card Background Gradient -->
                                <Frame.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#111111" Offset="0"/>
                                        <GradientStop Color="#151821" Offset="1"/>
                                    </LinearGradientBrush>
                                </Frame.Background>

                                <!-- Main Grid: Text (Left) | Image (Right) -->
                                <Grid ColumnDefinitions="*,50">

                                    <!-- Left Column: Text Content -->
                                    <VerticalStackLayout 
                                       Grid.Column="0"
                                       Padding="16,1,10,12"
                                       Spacing="0"
                                        
                                       VerticalOptions="Center"
                                       HorizontalOptions="Fill">

                                        <Label 
                                           Text="{Binding NameServies}" 
                                           FontFamily="Oswald" 
                                           TextColor="#FFFFFF" 
                                           FontSize="13"
                                           
                                           
                                           LineBreakMode="WordWrap"
                                           MaxLines="0"
                                           HorizontalTextAlignment="Start" />

                                    </VerticalStackLayout>

                                    <!-- Right Column: Image with fade overlay -->
                                    <Grid 
                                       Grid.Column="1"
                                       Padding="-10,0,0,0"
                                       ColumnDefinitions="*"
                                       RowDefinitions="*">

                                        <!-- Service Image (rectangular, no clipping) -->
                                        <ff:CachedImage
                                           Grid.Row="0"
                                           Grid.Column="0"
                                            WidthRequest="60"
                                           Source="{Binding ImageSafe}"
                                           Aspect="AspectFit"
                                           
                                           Opacity="0.92"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center" />

                                        <!-- Horizontal Fade Overlay (left dark to right transparent) -->
                                        <BoxView 
                                           Grid.Row="0"
                                           Grid.Column="0"
                                           HorizontalOptions="Fill"
                                           VerticalOptions="Fill">
                                            <BoxView.Background>
                                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                    <GradientStop Color="#33000000" Offset="0"/>
                                                    <GradientStop Color="#00000000" Offset="0"/>
                                                </LinearGradientBrush>
                                            </BoxView.Background>
                                        </BoxView>

                                    </Grid>

                                </Grid>

                            </Frame>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
                <HorizontalStackLayout>

                    <Frame BorderColor="#444444" HeightRequest="100" Margin="24,10,24,10" CornerRadius="16" BackgroundColor="#444444" WidthRequest="100" sk:Skeleton.IsBusy="{Binding IsWorkTeamLoad}" IsVisible="{Binding IsWorkTeamLoad }" sk:Skeleton.Animation="{sk:DefaultAnimation Fade}">
                        <Frame CornerRadius="30" Margin="0,0,0,0" BackgroundColor="#303030" BorderColor="#303030" />
                    </Frame>

                    <Frame BorderColor="#444444" HeightRequest="100" Margin="24,10,24,10" CornerRadius="16" BackgroundColor="#444444" WidthRequest="100" sk:Skeleton.IsBusy="{Binding IsWorkTeamLoad}" IsVisible="{Binding IsWorkTeamLoad }" sk:Skeleton.Animation="{sk:DefaultAnimation Fade}">
                        <Frame CornerRadius="30" Margin="0,0,0,0" BackgroundColor="#303030" BorderColor="#303030" />
                    </Frame>

                    <Frame BorderColor="#444444" HeightRequest="100" Margin="24,10,24,10" CornerRadius="16" BackgroundColor="#444444" WidthRequest="100" sk:Skeleton.IsBusy="{Binding IsWorkTeamLoad}" IsVisible="{Binding IsWorkTeamLoad }" sk:Skeleton.Animation="{sk:DefaultAnimation Fade}">
                        <Frame CornerRadius="30" Margin="0,0,0,0" BackgroundColor="#303030" BorderColor="#303030" />
                    </Frame>

                    <Frame BorderColor="#444444" HeightRequest="100" Margin="24,10,24,10" CornerRadius="16" BackgroundColor="#444444" WidthRequest="100" sk:Skeleton.IsBusy="{Binding IsWorkTeamLoad}" IsVisible="{Binding IsWorkTeamLoad }" sk:Skeleton.Animation="{sk:DefaultAnimation Fade}">
                        <Frame CornerRadius="30" Margin="0,0,0,0" BackgroundColor="#303030" BorderColor="#303030" />
                    </Frame>

                    <Frame BorderColor="#444444" HeightRequest="100" Margin="24,10,24,10" CornerRadius="16" BackgroundColor="#444444" WidthRequest="100" sk:Skeleton.IsBusy="{Binding IsWorkTeamLoad}" IsVisible="{Binding IsWorkTeamLoad }" sk:Skeleton.Animation="{sk:DefaultAnimation Fade}">
                        <Frame CornerRadius="30" Margin="0,0,0,0" BackgroundColor="#303030" BorderColor="#303030" />
                    </Frame>

                    <Frame BorderColor="#444444" HeightRequest="100" Margin="24,10,24,10" CornerRadius="16" BackgroundColor="#444444" WidthRequest="100" sk:Skeleton.IsBusy="{Binding IsWorkTeamLoad}"  IsVisible="{Binding IsWorkTeamLoad }" sk:Skeleton.Animation="{sk:DefaultAnimation Fade}">
                        <Frame CornerRadius="30" Margin="0,0,0,0" BackgroundColor="#303030" BorderColor="#303030" />
                    </Frame>

                </HorizontalStackLayout>
                <Label Text="{Loc:Translate Name=TitelTeam}" FontSize="24" Margin="24,20,0,0" TextColor="White" FontFamily="georgia" />
               
                <CollectionView ItemsSource="{Binding WorkTeams}" ItemsLayout="HorizontalList"   Margin="0,0,20,50" >
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="Transparent" CornerRadius="20" WidthRequest="140"  BorderColor="Transparent" >
                                <VerticalStackLayout  Margin="12" Spacing="0">
                                    <Frame BackgroundColor="#0B0D10" 
WidthRequest="70" 
HeightRequest="70" 
CornerRadius="38"
Padding="0"
BorderColor="#333333"
HasShadow="False">
                                        <ff:CachedImage
 WidthRequest="70"
 HeightRequest="70"
 Aspect="Fill"
 FadeAnimationEnabled="True"
 DownsampleToViewSize="True"
 BackgroundColor="#0B0D10"
 IsOpaque="False"
 Source="{Binding ImageSafe}" />
                                    </Frame>
                                    <Label Text="{Binding Name}" TextColor="#999999" HorizontalOptions="Center" FontSize="12" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!--<VerticalStackLayout BackgroundColor="#202020" Padding="0" Spacing="0">
                   
                    <Label Text="{ Loc:Translate Name=chosesservies}" FontFamily="georgia" TextColor="#D3D3D3" Margin="24,20,0,0" FontSize="24" />

                    <HorizontalStackLayout Margin="0,10,10,10">
                        <Frame HeightRequest="55"  IsVisible="{Binding IsCatogory}" BorderColor="#444444" WidthRequest="120" Margin="20,0,0,0" CornerRadius="16" BackgroundColor="#444444" sk:Skeleton.IsBusy="{Binding IsCatogory}"  sk:Skeleton.Animation="{sk:DefaultAnimation Fade}"  />
                        <Frame HeightRequest="55"  IsVisible="{Binding IsCatogory}"  BorderColor="#444444" WidthRequest="120" Margin="17,0,0,0" CornerRadius="16" BackgroundColor="#444444" sk:Skeleton.IsBusy="{Binding IsCatogory}"  sk:Skeleton.Animation="{sk:DefaultAnimation Fade}"  />
