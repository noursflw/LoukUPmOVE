            </VerticalStackLayout>
        </ScrollView>
        <Frame Grid.Row="1" Background="#111111" BorderColor="Transparent" Padding="0" HeightRequest="70" VerticalOptions="End" HorizontalOptions="Fill" CornerRadius="10" Margin="10,0,10,30">
            <Grid ColumnDefinitions="*,Auto" Padding="0">
                <HorizontalStackLayout Grid.Column="0" HorizontalOptions="Start" Spacing="10" Padding="20,15,0,15">
                    <Image Source="calendartick" WidthRequest="24" HeightRequest="24"/>
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label  TextColor="White" Text="{Loc:Translate Name=timetosphelstel}" FontSize="Default"/>
                        <Label TextColor="White" Text="{Loc:Translate Name=yourstylestatuphere}" FontSize="12"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
                <Button ImageSource="calendarticky.svg"  Text="{Loc:Translate Name=bookinNowAbotus}" FontFamily="OpenSansSemibold" TextColor="Black"  Grid.Column="1" HorizontalOptions="End" FontSize="Micro" VerticalOptions="Center" Margin="0,0,20,0"  HeightRequest="40"/>
            </Grid>
        </Frame>

        <Border Grid.Row="1"
        Margin="0,0,0,-10"
        HeightRequest="20"
        VerticalOptions="End"
        HorizontalOptions="Fill"
        StrokeShape="RoundRectangle 40,40,0,0"
        Background="#151821"
        Stroke="#151821" />

    </Grid>
</ContentPage>