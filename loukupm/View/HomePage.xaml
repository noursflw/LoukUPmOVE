<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="loukupm.View.HomePage" 
             xmlns:converters="clr-namespace:loukupm.Converter"
             xmlns:sk="clr-namespace:Maui.Skeleton;assembly=Sharpnado.HorusSkeleton.Maui"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:Loc="clr-namespace:loukupm.Langue"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="True"
             FlowDirection="LeftToRight"
             xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             xmlns:vm="clr-namespace:loukupm.ViewModel"
             BackgroundColor="#202020"
             Title="HomePage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid RowDefinitions="*,Auto">
   
        <ScrollView Grid.Row="0" Margin="0,0,0,40">
            <VerticalStackLayout>
              
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
                    
                    <HorizontalStackLayout Grid.Column="0" Spacing="5"  IsVisible="{Binding  IsLoadUser, Converter={StaticResource InverseBoolConverter}}"  >
                        <Label Margin="25,10,0,0"
           FontSize="18"
           FontFamily="Oswald"
           TextColor="#999999"
           Text="{Loc:Translate Name=Wellcom}"/>

                        <Label Text="{Binding UserName}"
           Margin="0,10,0,0"
           FontSize="18"

           FontFamily="Oswald"
           TextColor="#999999"/>

                        <Label Text="✨🎉" Margin="0,10,0,0" />
                    </HorizontalStackLayout>


                    <Frame HeightRequest="10" Margin="20,0,0,0" WidthRequest="120" CornerRadius="3" BackgroundColor="#444444"
       BorderColor="#444444"
       sk:Skeleton.IsBusy="{Binding IsLoadUser}"
                           IsVisible="{Binding IsLoadUser}"
       sk:Skeleton.Animation="{sk:DefaultAnimation Fade}"/>

                    <BoxView BackgroundColor="Transparent" Grid.Column="1" />

               
                    <HorizontalStackLayout Margin="0,10,20,0" Grid.Column="2" Spacing="10">

                       

                        <ImageButton 
                            CornerRadius="10"
        HeightRequest="40" 
        WidthRequest="40" 
        Clicked="Button_Clicked" 
        BackgroundColor="#444444" 
        Source="nn1.png"
        Padding="0"/>

                       
                    </HorizontalStackLayout>

                </Grid>

                <Label Text="{Loc:Translate Name=aboutaswelcom}" FontFamily="georgia-bold"  FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#D3D3D3" Margin="0,30,0,10"/>
                <Label
Text="LOOK UP Friseur" FontFamily="georgia-bold" TextColor="#EBD750" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" >

                    <CarouselView x:Name="carouselView"
                               HeightRequest="250" 
                               PeekAreaInsets="13"

                  IndicatorView="{x:Reference indicatorView}" 
                  Loop="True"
                  IsSwipeEnabled="True">
                        <CarouselView.ItemsSource>
                            <x:Array Type="{x:Type ImageSource}">
                                <FileImageSource File="macn1.jpg"/>
                                <FileImageSource File="macan2.jpg"/>
                                <FileImageSource File="macan3.jpg"/>
                                <FileImageSource File="m1.jpg"/>
                                <FileImageSource File="m2.jpg"/>
                                <FileImageSource File="m3.jpg"/>

                            </x:Array>
                        </CarouselView.ItemsSource>

                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Frame Padding="0"
                           HasShadow="True"
                           CornerRadius="20"
                           HeightRequest="200"
                           WidthRequest="320"
                           HorizontalOptions="Center">
                                        <Image Source="{Binding .}"
                               Aspect="Fill"/>
                                    </Frame>
                                </Grid>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                  
                    <IndicatorView x:Name="indicatorView"
                   IndicatorColor="LightGray"
                   SelectedIndicatorColor="#EBD750"
                   HorizontalOptions="Center"
                   Margin="0,10"/>

                </VerticalStackLayout>

                <Label Text="{Loc:Translate Name=TitelTeam}" FontSize="24" Margin="24,20,0,0" TextColor="#EBD750" FontFamily="georgia" />
                <Label Text="{Loc:Translate   Name=Titledescrption}" FontSize="14" Margin="24,0,0,0" TextColor="White" FontFamily="Oswald" />

                <HorizontalStackLayout>

                    <Frame BorderColor="#444444" HeightRequest="100" Margin="24,10,24,10" CornerRadius="16" BackgroundColor="#444444" WidthRequest="100" sk:Skeleton.IsBusy="{Binding IsWorkTeamLoad}" IsVisible="{Binding IsWorkTeamLoad }" sk:Skeleton.Animation="{sk:DefaultAnimation Fade}">
                        <Frame CornerRadius="30" Margin="0,0,0,0" BackgroundColor="#303030" BorderColor="#303030" />
                    </Frame>

                    <Frame BorderColor="#444444" HeightRequest="100" Margin="24,10,24,10" CornerRadius="16" BackgroundColor="#444444" WidthRequest="100" sk:Skeleton.IsBusy="{Binding IsWorkTeamLoad}" IsVisible="{Binding IsWorkTeamLoad }" sk:Skeleton.Animation="{sk:DefaultAnimation Fade}">
                        <Frame CornerRadius="30" Margin="0,0,0,0" BackgroundColor="#303030" BorderColor="#303030" />
                    </Frame>

                    <Frame BorderColor="#444444" HeightRequest="100" Margin="24,10,24,10" CornerRadius="16" BackgroundColor="#444444" WidthRequest="100" sk:Skeleton.IsBusy="{Binding IsWorkTeamLoad}" IsVisible="{Binding IsWorkTeamLoad }" sk:Skeleton.Animation="{sk:DefaultAnimation Fade}">
                        <Frame CornerRadius="30" Margin="0,0,0,0" BackgroundColor="#303030" BorderColor="#303030" />
                    </Frame>

                    <Frame BorderColor="#444444" HeightRequest="100" Margin="24,10,24,10" CornerRadius="16" BackgroundColor="#444444" WidthRequest="100" sk:Skeleton.IsBusy="{Binding IsWorkTeamLoad}" IsVisible="{Binding IsWorkTeamLoad }" sk:Skeleton.Animation="{sk:DefaultAnimation Fade}">
                        <Frame CornerRadius="30" Margin="0,0,0,0" BackgroundColor="#303030" BorderColor="#303030" />
                    </Frame>

                    <Frame BorderColor="#444444" HeightRequest="100" Margin="24,10,24,10" CornerRadius="16" BackgroundColor="#444444" WidthRequest="100" sk:Skeleton.IsBusy="{Binding IsWorkTeamLoad}" IsVisible="{Binding IsWorkTeamLoad }" sk:Skeleton.Animation="{sk:DefaultAnimation Fade}">
                        <Frame CornerRadius="30" Margin="0,0,0,0" BackgroundColor="#303030" BorderColor="#303030" />
                    </Frame>

                    <Frame BorderColor="#444444" HeightRequest="100" Margin="24,10,24,10" CornerRadius="16" BackgroundColor="#444444" WidthRequest="100" sk:Skeleton.IsBusy="{Binding IsWorkTeamLoad}"  IsVisible="{Binding IsWorkTeamLoad }" sk:Skeleton.Animation="{sk:DefaultAnimation Fade}">
                        <Frame CornerRadius="30" Margin="0,0,0,0" BackgroundColor="#303030" BorderColor="#303030" />
                    </Frame>

                </HorizontalStackLayout>

                <CollectionView ItemsSource="{Binding WorkTeams}" ItemsLayout="HorizontalList" Margin="0,10,0,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="#202020" BorderColor="#202020"  Margin="6">
                                <VerticalStackLayout Margin="12" Spacing="8">
                                    <Frame BackgroundColor="#333333" 
                                           WidthRequest="100" 
                                           HeightRequest="100" 
                                           CornerRadius="50"
                                           Padding="0"
                                           BorderColor="#333333"
                                           HasShadow="False">
                                        <ff:CachedImage
                                            WidthRequest="100"
                                            HeightRequest="100"
                                            Aspect="AspectFill"
                                            FadeAnimationEnabled="True"
                                            DownsampleToViewSize="True"
                                            BackgroundColor="#333333"
                                            IsOpaque="False"
                                            Source="{Binding ImageSafe}" />
                                    </Frame>
                                    <Label Text="{Binding Name}" TextColor="#999999" HorizontalOptions="Center" FontSize="12" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <VerticalStackLayout BackgroundColor="#202020" Padding="0" Spacing="0">
                    <material:TextField FlowDirection="LeftToRight" 
    Margin="25,10,25,0" 
    InputBackgroundColor="#444444" 
    CornerRadius="16" 
    Icon="search.svg" 
    Title="search" 
    HeightRequest="56"
    Text="{Binding SearchServiceTerm}" />
                    <Label Text="{ Loc:Translate Name=chosesservies}" FontFamily="georgia" TextColor="#D3D3D3" Margin="24,20,0,0" FontSize="24" />

                    <HorizontalStackLayout Margin="0,10,10,10">
                        <Frame HeightRequest="55"  IsVisible="{Binding IsCatogory}" BorderColor="#444444" WidthRequest="120" Margin="20,0,0,0" CornerRadius="16" BackgroundColor="#444444" sk:Skeleton.IsBusy="{Binding IsCatogory}"  sk:Skeleton.Animation="{sk:DefaultAnimation Fade}"  />
                        <Frame HeightRequest="55"  IsVisible="{Binding IsCatogory}"  BorderColor="#444444" WidthRequest="120" Margin="17,0,0,0" CornerRadius="16" BackgroundColor="#444444" sk:Skeleton.IsBusy="{Binding IsCatogory}"  sk:Skeleton.Animation="{sk:DefaultAnimation Fade}"  />
                    </HorizontalStackLayout>
                    <CollectionView x:Name="CategoriesCollectionView"
   ItemsSource="{Binding Categories}" 
   Margin="17,10,10,10">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <ContentView x:Name="FrameContainer" HeightRequest="65"  Padding="0">
                                    <Frame x:Name="CategoryFrame"
                                           CornerRadius="16"
                                           HeightRequest="53"        
                                           BackgroundColor="#444444"
                                           Margin="0,0,0,0"
                                           BorderColor="#444444"
          HasShadow="False"
          IsClippedToBounds="True">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnCategoryTapped" />
                                        </Frame.GestureRecognizers>

                                        <Label Text="{Binding Name}"
              FontFamily="Oswald"
              Margin="0,-8,0,0"
              TextColor="#999999" />
                                    </Frame>
                                </ContentView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Label Text="{ Loc:Translate Name=AllServies}" Margin="24,0,0,10" FontSize="14" TextColor="White" FontFamily="Oswald" TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>

                <!-- Services Section -->
                <VerticalStackLayout Spacing="10">
                    <Frame HeightRequest="122" Margin="20,10,20,0"
                           WidthRequest="350"
                           CornerRadius="16" 
                           BackgroundColor="#444444"
                           sk:Skeleton.IsBusy="{Binding IsCatogory}" 
                           sk:Skeleton.Animation="{sk:DefaultAnimation Fade}" 
                           BorderColor="#444444"
                           IsVisible="{Binding IsCatogory}" />

                    <!-- CollectionView يظهر فقط بعد انتهاء التحميل -->
                    <CollectionView ItemsSource="{Binding FilteredServices}" 
                    IsVisible="{Binding IsServicesLoad, Converter={StaticResource InverseBoolConverter}}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Margin="24,0,24,0" Spacing="10">
                                    <Frame Margin="3" BorderColor="#444444"  BackgroundColor="#444444" CornerRadius="16" HeightRequest="100">
                                        <Grid ColumnDefinitions="50*,50*" RowDefinitions="Auto,Auto,Auto">
                                            <Label Grid.Column="0" Grid.Row="0" Text="{Binding NameServies}" FontFamily="Oswald" TextColor="#D3D3D3" FontSize="18" />

                                            <HorizontalStackLayout Grid.Column="0" Grid.Row="1" Spacing="5" Margin="0,8,0,0">
                                                <Label Text="€" FontSize="14" VerticalOptions="Center" />
                                                <Label Text="{Binding PriceServies}" FontFamily="Oswald" TextColor="#D3D3D3" FontSize="14" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <Button 
                                                Grid.Column="1" 
                                                Grid.Row="0"
                                                Grid.RowSpan="3"
                                                Text="Auswählen" 
                                                TextColor="White" 
                                                BackgroundColor="Black" 
                                                WidthRequest="132" 
                                                FontFamily="Oswald" 
                                                FontSize="16"   
                                                CornerRadius="16"  
                                                HeightRequest="48" 
                                                Margin="10,0,0,0"
                                                Clicked="Button_Clicked_1" />
                                        </Grid>
                                    </Frame>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" Margin="0,0,0,0"
             BackgroundColor="#444444"
             HeightRequest="20"
             VerticalOptions="End" 
             HorizontalOptions="Fill" 
             Stroke="#444444" 
             StrokeShape="RoundRectangle 10,10,0,0" />

    </Grid>
</ContentPage>