<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="loukupm.View.HomePage" 
             xmlns:converters="clr-namespace:loukupm.Converter"
             xmlns:sk="clr-namespace:Maui.Skeleton;assembly=Sharpnado.HorusSkeleton.Maui"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:Loc="clr-namespace:loukupm.Langue"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="True"
             FlowDirection="LeftToRight"
             xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             xmlns:vm="clr-namespace:loukupm.ViewModel"
             BackgroundColor="#202020"
             Title="HomePage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid>
        <ScrollView Margin="0,0,0,40">
            <VerticalStackLayout>

                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
                    <!-- العناصر الأولى -->
                    <HorizontalStackLayout Grid.Column="0" Spacing="5"  IsVisible="{Binding  IsLoadUser, Converter={StaticResource InverseBoolConverter}}"  >
                        <Label Margin="25,7,0,0"
           FontSize="18"
           FontFamily="Oswald"
           TextColor="#999999"
           Text="{Loc:Translate Name=Wellcom}"/>

                        <Label Text="{Binding UserName}"
           Margin="0,7,0,0"
           FontSize="18"
                            
           FontFamily="Oswald"
           TextColor="#999999"/>

                        <Label Text="✨🎉" Margin="0,7,0,0" />
                    </HorizontalStackLayout>


                    <Frame HeightRequest="10" Margin="20,0,0,0" WidthRequest="120" CornerRadius="3" BackgroundColor="#444444"
       BorderColor="#444444"
       sk:Skeleton.IsBusy="{Binding IsLoadUser}"
                           IsVisible="{Binding IsLoadUser}"
       sk:Skeleton.Animation="{sk:DefaultAnimation Fade}"/>
                  
                    <BoxView BackgroundColor="Transparent" Grid.Column="1" />

                    <!-- الأزرار -->
                    <HorizontalStackLayout Margin="0,0,20,0" Grid.Column="2" Spacing="10">

                        <ImageButton CornerRadius="10"
                           HeightRequest="40" 
                           WidthRequest="40" 
                           Clicked="Button_Clicked_2" 
                           BackgroundColor="#444444" 
                           Source="nv2.png"
                           Padding="10"/>

                        <ImageButton 
                            CornerRadius="10"
        HeightRequest="40" 
        WidthRequest="40" 
        Clicked="Button_Clicked" 
        BackgroundColor="#444444" 
        Source="nn1.png"
        Padding="0"/>

                        <ImageButton 
                            CornerRadius="10"
        HeightRequest="40" 
        WidthRequest="40" 
        Clicked="ImageButton_Clicked" 
        BackgroundColor="#444444" 
        Source="info.png"
        Padding="10"/>

                    </HorizontalStackLayout>

                </Grid>





                <material:TextField FlowDirection="LeftToRight" 
                                   Margin="25,35,25,0" 
                                   InputBackgroundColor="#444444" 
                                   CornerRadius="16" 
                                   Icon="search.svg" 
                                   Title="search" 
                                   HeightRequest="56"
                                   Text="{Binding SearchServiceTerm}" />
               
               
                <StackLayout Margin="24,20,0,0">
                
                    <Frame HeightRequest="150" Margin="20,0,40,0"
                         WidthRequest="350"
                         CornerRadius="16" 
                         BackgroundColor="#444444"
                         sk:Skeleton.IsBusy="{Binding IsCouselLoad}" 
                        sk:Skeleton.Animation="{sk:DefaultAnimation Fade}" 
                        BorderColor="#444444" />

                    <CarouselView ItemsSource="{Binding CarouselItems}" WidthRequest="300" HeightRequest="200" IsVisible="{Binding IsCouselLoad, Converter={StaticResource InverseBoolConverter}}">
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Frame CornerRadius="16" BackgroundColor="#444444">
                                    <Label Text="{Binding Name}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontSize="20" />
                                </Frame>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>
                </StackLayout>

                <Label Text="{Loc:Translate Name=TitelTeam}" FontSize="24" Margin="24,20,0,0" TextColor="#EBD750" FontFamily="georgia" />
                <Label Text="{Loc:Translate   Name=Titledescrption}" FontSize="14" Margin="24,0,0,0" TextColor="White" FontFamily="Oswald" />

                <HorizontalStackLayout>

                    <Frame BorderColor="#444444" HeightRequest="100" Margin="24,10,24,10" CornerRadius="16" BackgroundColor="#444444" WidthRequest="100" sk:Skeleton.IsBusy="{Binding IsWorkTeamLoad}" IsVisible="{Binding IsWorkTeamLoad }" sk:Skeleton.Animation="{sk:DefaultAnimation Fade}">
                        <Frame CornerRadius="30" Margin="0,0,0,0" BackgroundColor="#303030" BorderColor="#303030" />
                    </Frame>

                    <Frame BorderColor="#444444" HeightRequest="100" Margin="24,10,24,10" CornerRadius="16" BackgroundColor="#444444" WidthRequest="100" sk:Skeleton.IsBusy="{Binding IsWorkTeamLoad}" IsVisible="{Binding IsWorkTeamLoad }" sk:Skeleton.Animation="{sk:DefaultAnimation Fade}">
                        <Frame CornerRadius="30" Margin="0,0,0,0" BackgroundColor="#303030" BorderColor="#303030" />
                    </Frame>

                    <Frame BorderColor="#444444" HeightRequest="100" Margin="24,10,24,10" CornerRadius="16" BackgroundColor="#444444" WidthRequest="100" sk:Skeleton.IsBusy="{Binding IsWorkTeamLoad}" IsVisible="{Binding IsWorkTeamLoad }" sk:Skeleton.Animation="{sk:DefaultAnimation Fade}">
                        <Frame CornerRadius="30" Margin="0,0,0,0" BackgroundColor="#303030" BorderColor="#303030" />
                    </Frame>

                    <Frame BorderColor="#444444" HeightRequest="100" Margin="24,10,24,10" CornerRadius="16" BackgroundColor="#444444" WidthRequest="100" sk:Skeleton.IsBusy="{Binding IsWorkTeamLoad}" IsVisible="{Binding IsWorkTeamLoad }" sk:Skeleton.Animation="{sk:DefaultAnimation Fade}">
                        <Frame CornerRadius="30" Margin="0,0,0,0" BackgroundColor="#303030" BorderColor="#303030" />
                    </Frame>

                    <Frame BorderColor="#444444" HeightRequest="100" Margin="24,10,24,10" CornerRadius="16" BackgroundColor="#444444" WidthRequest="100" sk:Skeleton.IsBusy="{Binding IsWorkTeamLoad}" IsVisible="{Binding IsWorkTeamLoad }" sk:Skeleton.Animation="{sk:DefaultAnimation Fade}">
                        <Frame CornerRadius="30" Margin="0,0,0,0" BackgroundColor="#303030" BorderColor="#303030" />
                    </Frame>

                    <Frame BorderColor="#444444" HeightRequest="100" Margin="24,10,24,10" CornerRadius="16" BackgroundColor="#444444" WidthRequest="100" sk:Skeleton.IsBusy="{Binding IsWorkTeamLoad}"  IsVisible="{Binding IsWorkTeamLoad }" sk:Skeleton.Animation="{sk:DefaultAnimation Fade}">
                        <Frame CornerRadius="30" Margin="0,0,0,0" BackgroundColor="#303030" BorderColor="#303030" />
                    </Frame>

                </HorizontalStackLayout>

                <CollectionView ItemsSource="{Binding WorkTeams}" ItemsLayout="HorizontalList" IsVisible="{Binding IsWorkTeamLoad, Converter={StaticResource InverseBoolConverter}}">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame   BackgroundColor="#202020" BorderColor="#202020" Margin="6">
                                <VerticalStackLayout  Margin="12">

                                    <ff:CachedImage
                        WidthRequest="70"
                        HeightRequest="70"
                        Aspect="AspectFill"
                        Margin="0,0,0,20"                
                        FadeAnimationEnabled="True"
                        DownsampleToViewSize="True"
                        LoadingPlaceholder="placeholder.png"
                        ErrorPlaceholder="placeholder.png"
                        Source="{Binding ImageSafe}" />
                                    <!-- ملاحظة هنا -->


                                    <Label Text="{Binding Name}" TextColor="#999999" />
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{ Loc:Translate Name=chosesservies}" FontFamily="georgia" TextColor="#D3D3D3" Margin="24,20,0,0" FontSize="24" />

                <HorizontalStackLayout Margin="0,10,10,10">
                    <Frame HeightRequest="55"  IsVisible="{Binding IsCatogory}" BorderColor="#444444" WidthRequest="120" Margin="20,0,0,0" CornerRadius="16" BackgroundColor="#444444" sk:Skeleton.IsBusy="{Binding IsCatogory}"  sk:Skeleton.Animation="{sk:DefaultAnimation Fade}"  />
                    <Frame HeightRequest="55"  IsVisible="{Binding IsCatogory}"  BorderColor="#444444" WidthRequest="120" Margin="17,0,0,0" CornerRadius="16" BackgroundColor="#444444" sk:Skeleton.IsBusy="{Binding IsCatogory}"  sk:Skeleton.Animation="{sk:DefaultAnimation Fade}"  />


                </HorizontalStackLayout>
                <CollectionView x:Name="CategoriesCollectionView"
   ItemsSource="{Binding Categories}" 
   Margin="17,10,10,10">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <ContentView x:Name="FrameContainer" HeightRequest="65"  Padding="0">
                                <Frame x:Name="CategoryFrame"
                                       CornerRadius="16"
                                       HeightRequest="53"        
                                       BackgroundColor="#444444"
                                       Margin="0,0,0,0"
                                       BorderColor="#444444"
          HasShadow="False"
          IsClippedToBounds="True">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCategoryTapped" />
                                    </Frame.GestureRecognizers>

                                    <Label Text="{Binding Name}"
              FontFamily="Oswald"
              Margin="0,-8,0,0"
              TextColor="#999999" />
                                </Frame>
                            </ContentView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="{ Loc:Translate Name=AllServies}" Margin="24,0,0,10" FontSize="14" TextColor="White" FontFamily="Oswald" TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                    </Label.GestureRecognizers>
                </Label>

                <VerticalStackLayout HeightRequest="800">
                    <ScrollView>
                        <VerticalStackLayout Spacing="10">

                            
                            <Frame HeightRequest="122" Margin="20,10,20,0"
                                   WidthRequest="350"
                                   CornerRadius="16" 
                                   BackgroundColor="#444444"
                                   sk:Skeleton.IsBusy="{Binding IsCatogory}" 
                                   sk:Skeleton.Animation="{sk:DefaultAnimation Fade}" 
                                   BorderColor="#444444"
                                   IsVisible="{Binding IsCatogory}" />

                            <!-- CollectionView يظهر فقط بعد انتهاء التحميل -->
                            <CollectionView ItemsSource="{Binding FilteredServices}" 
                            IsVisible="{Binding IsServicesLoad, Converter={StaticResource InverseBoolConverter}}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Margin="24,0,24,0" Spacing="10">
                                            <Frame Margin="3" BorderColor="#444444" BackgroundColor="#444444" CornerRadius="16" HeightRequest="122">
                                                <Grid ColumnDefinitions="50*,50*">
                                                    <Label Grid.Column="0" Text="{Binding NameServies}" FontFamily="Oswald" TextColor="#D3D3D3" FontSize="18" />
                                                    <Label Grid.Column="0" Text="{Binding PriceServies}" Margin="0,30,0,0" FontFamily="Oswald" TextColor="#D3D3D3" FontSize="14" />
                                                    <Label Grid.Column="0" Text="{Binding TimeServies}" Margin="0,55,0,0" FontFamily="Oswald" TextColor="#D3D3D3" FontSize="14" />
                                                    <Button 
                                                        Grid.Column="1" 
                                                        Text="Auswählen" 
                                                        TextColor="White" 
                                                        BackgroundColor="Black" 
                                                        WidthRequest="132" 
                                                        FontFamily="Oswald" 
                                                        FontSize="16"   
                                                        CornerRadius="16"  
                                                        HeightRequest="48" 
                                                        Margin="10,-30,0,0"
                                                        Clicked="Button_Clicked_1"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AppViewModel}}, Path=SelectServiceButtonCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Grid>
                                            </Frame>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                        </VerticalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>


            </VerticalStackLayout>
        </ScrollView>
        <Border Margin="0,0,0,0"
             BackgroundColor="#444444"
             HeightRequest="20"
             VerticalOptions="End" 
             HorizontalOptions="Fill" 
             Stroke="#444444" 
             StrokeShape="RoundRectangle 10,10,0,0" />

    </Grid>
</ContentPage>