<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#252525"
             FlowDirection="LeftToRight"
             xmlns:Loc="clr-namespace:loukupm.Langue"
             BackgroundImageSource="baackgroundpage.png"
             x:Class="loukupm.View.AboutUS"
             Title=" ">
    <ScrollView>
        <VerticalStackLayout>
            <VerticalStackLayout Spacing="10" >
                <Label Text="{Loc:Translate Name=aboutaswelcom}" FontFamily="georgia-bold"  FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#D3D3D3" Margin="0,80,0,10"/>
                <Label
                Text="LOOK UP Friseur" FontFamily="georgia-bold" TextColor="#EBD750" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"  Margin="0,10,0,10"/>
                <Label Text="{Loc:Translate Name=DescriptionAboutus}" FontFamily="georgia-bold" TextColor="#999999" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center"  Margin="20,10,20,20"/>
                <Label Text="{Loc:Translate Name=VisteInAboutUS}" FontFamily="georgia-bold" TextColor="#EBD750" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center"  Margin="20,10,20,10"/>
                <Button  
                       Clicked="Button_Clicked"
                    WidthRequest="300"
                      TextColor="#1F1B04" FontSize="22" FontFamily="georgia-bold"
                      BorderWidth="1" Text="{Loc:Translate Name=bookinNowAbotus}" CornerRadius="16"
                      Margin="35,60,35,20"  />
                <Border Stroke="White" StrokeThickness="3" StrokeShape="Ellipse"
        HeightRequest="300"
        WidthRequest="300"
        HorizontalOptions="Center"
        VerticalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="#EBD750"
                Offset="0,5"
                Radius="10"
                Opacity="0.2" />
                    </Border.Shadow>
                    <Image Source="hh.jpg"
           Aspect="AspectFill"
           HeightRequest="300"
                          
           WidthRequest="300">
                        <Image.Clip>
                            <EllipseGeometry Center="150,150" RadiusX="150" RadiusY="150" />
                        </Image.Clip>
                    </Image>
                </Border>

                <BoxView HeightRequest="1" BackgroundColor="Gray" Margin="0,10"/>
                <Label Text="{Loc:Translate Name=TitelTeam}" FontFamily="georgia-bold" TextColor="#EBD750" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"  Margin="0,10,0,10"/>
                <Border Stroke="White" StrokeThickness="4" StrokeShape="Ellipse"
HeightRequest="300"
WidthRequest="300"
HorizontalOptions="Center"
VerticalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="#EBD750"
Offset="0,5"
Radius="10"
Opacity="0.2" />
                    </Border.Shadow>
                    <Image Source="team1.jpg"  Margin="25"
                   HeightRequest="300"
                   WidthRequest="300"
                   Aspect="AspectFill">
                        <Image.Clip>
                            <EllipseGeometry Center="150,150" RadiusX="150" RadiusY="150" />
                        </Image.Clip>
                    </Image>
                </Border>
                <Label Text="{Loc:Translate Name=TeamNaser}" FontFamily="georgia-bold" TextColor="#EBD750" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"  Margin="0,10,0,10"/>
                <Label Text="{Loc:Translate Name=DesTeam1}" FontFamily="georgia-bold" TextColor="#999999" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center"  Margin="20,10,20,20"/>
                <BoxView HeightRequest="1" BackgroundColor="Gray" Margin="0,10"/>
                <Border Stroke="White" StrokeThickness="2" StrokeShape="Ellipse"
                        HeightRequest="300"
                        WidthRequest="300"
                       HorizontalOptions="Center"
                       VerticalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="#EBD750"
Offset="0,5"
Radius="10"
Opacity="0.2" />
                    </Border.Shadow>
                    <Image Source="team2.jpg"  Margin="25"
                      HeightRequest="300"
                      WidthRequest="300"
                      Aspect="AspectFill">
                    <Image.Clip>
                        <EllipseGeometry Center="150,150" RadiusX="150" RadiusY="150" />
                    </Image.Clip>
                   
                </Image>
              </Border>
                <Label Text="{Loc:Translate Name=AbutUSTeam2}" FontFamily="georgia-bold" TextColor="#EBD750" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"  Margin="0,10,0,10"/>
                <Label Text="{Loc:Translate Name=DesTeam2}" FontFamily="georgia-bold" TextColor="#999999" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center"  Margin="20,10,20,20"/>
                <BoxView HeightRequest="1" BackgroundColor="Gray" Margin="0,10"/>
                <Border Stroke="White" StrokeThickness="2" StrokeShape="Ellipse"
                        HeightRequest="300"
                        WidthRequest="300"
                       HorizontalOptions="Center"
                       VerticalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="#EBD750"
                             Offset="0,5"
                             Radius="10"
                             Opacity="0.2" />
                    </Border.Shadow>
                    <Image Source="team3.jpg"  Margin="25"
                       HeightRequest="300"
                       WidthRequest="300"
                       Aspect="AspectFill">
                        <Image.Clip>
                            <EllipseGeometry Center="150,150" RadiusX="150" RadiusY="150" />
                        </Image.Clip>
                    </Image>
                </Border>
                <Label Text="{Loc:Translate Name=AboutUSTeam3}" FontFamily="georgia-bold" TextColor="#EBD750" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"  Margin="0,10,0,10"/>
                <Label Text="{Loc:Translate Name=DesTeam3} " FontFamily="georgia-bold" TextColor="#999999" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center"  Margin="20,10,20,20"/>
                <BoxView HeightRequest="1" BackgroundColor="Gray" Margin="0,10"/>
                <Label Text="{Loc:Translate Name=aboutusga}" FontFamily="georgia-bold" TextColor="#EBD750" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"  Margin="0,10,0,10"/>
                <VerticalStackLayout Padding="20">
               
                    <CarouselView HeightRequest="250" 
                               PeekAreaInsets="13"
                 
                
                  Loop="True"
                  IsSwipeEnabled="True">
                        <CarouselView.ItemsSource>
                            <x:Array Type="{x:Type ImageSource}">
                                <FileImageSource File="macn1.jpg"/>
                                <FileImageSource File="macan2.jpg"/>
                                <FileImageSource File="macan3.jpg"/>
                                <FileImageSource File="m1.jpg"/>
                                <FileImageSource File="m2.jpg"/>
                                <FileImageSource File="m3.jpg"/>

                            </x:Array>
                        </CarouselView.ItemsSource>

                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Frame Padding="0"
                           HasShadow="True"
                           CornerRadius="20"
                           HeightRequest="250"
                           WidthRequest="300"
                           HorizontalOptions="Center">
                                        <Image Source="{Binding .}"
                               Aspect="Fill"/>
                                    </Frame>
                                </Grid>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <!-- Indicator Dots -->
                    <IndicatorView x:Name="indicatorView"
                   IndicatorColor="LightGray"
                   SelectedIndicatorColor="#EBD750"
                   HorizontalOptions="Center"
                   Margin="0,10"/>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>