<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#0A0A0A"
             xmlns:Loc="clr-namespace:loukupm.Langue"
             xmlns:converters="clr-namespace:loukupm.Converter"
             xmlns:sk="clr-namespace:Maui.Skeleton;assembly=Sharpnado.HorusSkeleton.Maui"
             xmlns:Convert="clr-namespace:loukupm.Converter"
             x:Class="loukupm.View.AboutUS"
             Title=" ">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="True" IsVisible="True" />
    </Shell.BackButtonBehavior>

    <ContentPage.Resources>
        <ResourceDictionary>
            <Convert:MultiLanguageConverter x:Key="MultiLanguageConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView BackgroundColor="#252525">
        <VerticalStackLayout BackgroundColor="#252525" >
            <VerticalStackLayout
           
            Padding="0" Spacing="0"   BackgroundColor="#0A0A0A">


                <VerticalStackLayout  IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" HeightRequest="280"
                     BackgroundColor="#0A0A0A"
                     Padding="0">

                    <Border Margin="25" StrokeThickness="0"
            BackgroundColor="#0A0A0A"
            StrokeShape="RoundRectangle 25">

                        <CarouselView HeightRequest="200"
                      Loop="True"
                      IsSwipeEnabled="True"
                      x:Name="heroCarousel"
                      AutomationId="heroCarousel"
                    
                      ItemsSource="{Binding AboutUsData.Hero.Images}">

                            <CarouselView.ItemTemplate>
                                <DataTemplate>
                                    <Grid RowDefinitions="*"
                          BackgroundColor="#1a1a1a">

                                     
                                        <Image Source="{Binding Url}"
                               Aspect="AspectFill"
                               Grid.Row="0"
                               Opacity="0.6"/>
                                        <BoxView BackgroundColor="#00000040"
                                 Grid.Row="0"/>

                                    </Grid>
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>

                    </Border>


                    <IndicatorView x:Name="heroIndicatorView"
                   IndicatorColor="LightGray"
                   SelectedIndicatorColor="#EBD750"
                   HorizontalOptions="Center"
                   Margin="0,15,0,0"/>
                </VerticalStackLayout>
                <Frame BorderColor="#444444" HeightRequest="150" Margin="24,50,24,10" WidthRequest="350"   CornerRadius="16" BackgroundColor="#444444"  sk:Skeleton.IsBusy="{Binding IsLoading}" IsVisible="{Binding IsLoading}" sk:Skeleton.Animation="{sk:DefaultAnimation Fade}"/>

                <VerticalStackLayout BackgroundColor="#0A0A0A" Padding="20" Spacing="15">



                    <Frame Padding="0" BackgroundColor="Wheat"  IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
       BorderColor="#0e1012">


                        <VerticalStackLayout BackgroundColor="#0e1012" >
                            <Label Text="{Binding AboutUsData.Hero.Subtitle, Converter={StaticResource MultiLanguageConverter}}"
FontFamily="georgia-bold"
TextColor="#999999"
FontSize="14"
HorizontalOptions="Center"
Margin="20,10,20,10"/>
                            <Label Text="{Binding AboutUsData.Hero.Description, Converter={StaticResource MultiLanguageConverter}}"
FontFamily="georgia-bold"
TextColor="#D3D3D3"
FontSize="12"
HorizontalOptions="Start"
Margin="20,10,20,20"
LineBreakMode="WordWrap"/>
                            <CarouselView ItemsSource="{Binding AboutUsData.Features}"
                                      x:Name="featuresCarousel"
                                      Loop="True"
                                      IsSwipeEnabled="True"
                                      HeightRequest="200">

                                <CarouselView.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="8"
                                                        Padding="15"
                                                        VerticalOptions="Center"
                                                        HorizontalOptions="Center">

                                            <Image Source="{Binding IconToImage}"
                                               HeightRequest="50"
                                               WidthRequest="50"
                                               HorizontalOptions="Center"/>

                                            <Label Text="{Binding Title, Converter={StaticResource MultiLanguageConverter}}"
                                               FontFamily="georgia-bold"
                                               FontSize="16"
                                               TextColor="#EBD750"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="WordWrap"/>

                                            <Label Text="{Binding Description, Converter={StaticResource MultiLanguageConverter}}"
                                               FontFamily="georgia-bold"
                                               FontSize="12"
                                               TextColor="#999999"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="WordWrap"
                                               MaximumWidthRequest="250"/>

                                        </VerticalStackLayout>

                                    </DataTemplate>
                                </CarouselView.ItemTemplate>

                            </CarouselView>
                        </VerticalStackLayout>

                    </Frame>
                    <Frame BorderColor="#444444" HeightRequest="300" Margin="24,50,24,10" WidthRequest="350"   CornerRadius="16" BackgroundColor="#444444"  sk:Skeleton.IsBusy="{Binding IsLoading}" IsVisible="{Binding IsLoading}" sk:Skeleton.Animation="{sk:DefaultAnimation Fade}"/>

                    <Label Text="{Loc:Translate Name=TitelTeam}" FontFamily="georgia-bold" TextColor="#EBD750" FontSize="24" HorizontalOptions="Center" Margin="0,30,0,10"/>

                    <CollectionView ItemsSource="{Binding AboutUsData.Team}"
                SelectionMode="None">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <Border Stroke="#0e1012"
                    StrokeThickness="1"
                    Padding="15"
                    BackgroundColor="#0e1012"
                    Margin="0,0,0,15">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="12"
                                     HorizontalOptions="Center">

                                       
                                        <Border Stroke="#EBD750"
                            StrokeThickness="2"
                            HeightRequest="150"
                            WidthRequest="150"
                            StrokeShape="RoundRectangle 80"
                            HorizontalOptions="Center">

                                            <Image Source="{Binding ImageUrl}"
                               Aspect="AspectFill">
                                                <Image.Clip>
                                                    <RoundRectangleGeometry Rect="0,0,150,150"
                                                        CornerRadius="60"/>
                                                </Image.Clip>
                                            </Image>

                                        </Border>

                                     
                                        <Label Text="{Binding Name, Converter={StaticResource MultiLanguageConverter}}"
                           FontFamily="georgia-bold"
                           FontSize="18"
                           TextColor="White"
                           HorizontalTextAlignment="Center"/>

                                       
                                        <Label Text="{Binding Position, Converter={StaticResource MultiLanguageConverter}}"
                           FontFamily="georgia-bold"
                           FontSize="14"
                           TextColor="#EBD750"
                           HorizontalTextAlignment="Center"/>

                                      
                                        <Label Text="{Binding Description, Converter={StaticResource MultiLanguageConverter}}"
                           FontFamily="georgia-bold"
                           FontSize="12"
                           TextColor="#999999"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"/>

                                    </VerticalStackLayout>

                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>
                    <Border
    IsVisible="{Binding IsLoading}"
    Stroke="#0e1012"
    StrokeThickness="1"
    Padding="15"
    BackgroundColor="Transparent"
    Margin="24,50,24,10">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>

                        <Grid ColumnSpacing="12" RowSpacing="12">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Card 1 -->
                            <Border Grid.Row="0"
                Grid.Column="0"
                Stroke="#0e1012"
                BackgroundColor="#0e1012"
                Padding="15">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="6">
                                    <BoxView HeightRequest="40" WidthRequest="40" Color="#333333" HorizontalOptions="Center"/>
                                    <BoxView HeightRequest="10" WidthRequest="80" Color="#333333" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Card 2 -->
                            <Border Grid.Row="0"
                Grid.Column="1"
                Stroke="#0e1012"
                BackgroundColor="#0e1012"
                Padding="15">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="6">
                                    <BoxView HeightRequest="40" WidthRequest="40" Color="#333333" HorizontalOptions="Center"/>
                                    <BoxView HeightRequest="10" WidthRequest="80" Color="#333333" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Card 3 -->
                            <Border Grid.Row="1"
                Grid.Column="0"
                Stroke="#0e1012"
                BackgroundColor="#0e1012"
                Padding="15">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="6">
                                    <BoxView HeightRequest="40" WidthRequest="40" Color="#333333" HorizontalOptions="Center"/>
                                    <BoxView HeightRequest="10" WidthRequest="80" Color="#333333" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Card 4 -->
                            <Border Grid.Row="1"
                Grid.Column="1"
                Stroke="#0e1012"
                BackgroundColor="#0e1012"
                Padding="15">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="6">
                                    <BoxView HeightRequest="40" WidthRequest="40" Color="#333333" HorizontalOptions="Center"/>
                                    <BoxView HeightRequest="10" WidthRequest="80" Color="#333333" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>

                        </Grid>

                    </Border>
                    <Border Stroke="#0e1012"
                       IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" 
                       StrokeThickness="1"
                       Padding="15"
                        BackgroundColor="Transparent">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>

                        <Grid ColumnSpacing="12"
          RowSpacing="12">

                           
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                           
                            <Border Grid.Row="0"
                Grid.Column="0"
                Stroke="#0e1012"
                BackgroundColor="#0e1012"
                 
                Padding="15">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="6">
                                    <Image Source="timery.png" HorizontalOptions="Center" />
                                    <Label Text="{Binding AboutUsData.Contact.OpeningHours, Converter={StaticResource MultiLanguageConverter}}"
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       TextColor="#999999"/>
                                </VerticalStackLayout>
                            </Border>

                          
                            <Border Grid.Row="0"
                Grid.Column="1"
                BackgroundColor="#0e1012"
                Stroke="#0e1012"
                Padding="15">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="6">

                                    <Image Source="emaily.png" HorizontalOptions="Center" />
                                    <Label Text="{Binding EmailLabel, Converter={StaticResource MultiLanguageConverter}}"
                       FontSize="14"
                       HorizontalOptions="Center"
                       TextColor="#EBD750"/>

                                    <Label Text="{Binding AboutUsData.Contact.Email}"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       HorizontalTextAlignment="Center"
                       TextColor="#999999"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Address -->
                            <Border Grid.Row="1"
                Grid.Column="0"
                BackgroundColor="#0e1012"
                Stroke="#0e1012"
                Padding="15">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="6">

                                    <Image Source="loctiony.png " HorizontalOptions="Center" />

                                    <Label Text="{Binding AboutUsData.Contact.Address.Label, Converter={StaticResource MultiLanguageConverter}}"
                       FontSize="14"
                       HorizontalOptions="Center"
                       TextColor="#EBD750"/>

                                    <Label Text="{Binding AboutUsData.Contact.Address.Value}"
                       FontSize="13"
                       LineBreakMode="WordWrap"
                       HorizontalTextAlignment="Center"
                       TextColor="#999999"/>
                                </VerticalStackLayout>
                            </Border>

                          
                            <Border Grid.Row="1"
                Grid.Column="1"
                BackgroundColor="#0e1012"
                Stroke="#0e1012"
                Padding="15">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="6">

                                    <Image Source="phoney.png" HorizontalOptions="Center" />

                                    <Label Text="{Binding AboutUsData.Contact.Phone.Label, Converter={StaticResource MultiLanguageConverter}}"
                       FontSize="14"
                       HorizontalOptions="Center"
                       TextColor="#EBD750"/>

                                    <Label Text="{Binding AboutUsData.Contact.Phone.Value}"
                       FontSize="13"
                       FlowDirection="LeftToRight"
                       HorizontalTextAlignment="Center"
                       TextColor="#999999"/>
                                </VerticalStackLayout>
                            </Border>

                        </Grid>

                    </Border>
                    <BoxView HeightRequest="1" BackgroundColor="#444444" Margin="0,30,0,15"/>

                 


                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
