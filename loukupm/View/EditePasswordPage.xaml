<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="loukupm.View.EditePasswordPage"
             Shell.NavBarIsVisible="False"
               xmlns:Loc="clr-namespace:loukupm.Langue"
             Shell.TabBarIsVisible="False"
               xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             BackgroundColor="#0A0A0A"
             Title="EditePasswordPage">
    <Grid>
        <ScrollView>
            <VerticalStackLayout>
                <Grid ColumnDefinitions="*,Auto" HeightRequest="60" BackgroundColor="#0A0A0A">
                   
                    <Label Text="{Loc:Translate Name=ChangPassord}"
                   TextColor="White"
                   Margin="24,0,0,0"
                     FontSize="24"
                     FontFamily="georgia-bold"
                     VerticalOptions="Center" />

                 
                    <Button Grid.Column="1"
                      WidthRequest="40"
                      HeightRequest="40"
                      CornerRadius="12"
                      ImageSource="backbuttonpmg.png"
                      BackgroundColor="#0A0A0A"
                      BorderColor="#0A0A0A"
                      Margin="0,0,10,0"            
                      BorderWidth="1"
                     HorizontalOptions="End"
                     VerticalOptions="Center"
                     Clicked="Button_Clicked" />
                </Grid>
              
                <Label FontSize="16" Margin="12,24,0,0" Text="{Loc:Translate Name=ChangMyPassword1}" TextColor="White" Padding="10" />
                <material:TextField Text="{Binding CurrentPassword}" 
                                    Title="{Loc:Translate Name=ChangMyPassword1}" 
                                    IsPassword="True"  
                                    Margin="25,0,25,0">
                    <material:TextField.Attachments>
                        <material:TextFieldPasswordShowHideAttachment />
                    </material:TextField.Attachments>
                </material:TextField>

             
                <Label FontSize="16" Margin="12,24,0,0" Text="{Loc:Translate Name=NewMyPassord}" TextColor="White" Padding="10" />
                <material:TextField Text="{Binding Password}" 
                                    Title="{Loc:Translate Name=NewMyPassord}" 
                                    IsPassword="True"  
                                    Margin="25,0,25,0">
                    <material:TextField.Attachments>
                        <material:TextFieldPasswordShowHideAttachment />
                    </material:TextField.Attachments>
                </material:TextField>

            
                <Label FontSize="16" Margin="12,24,0,0" Text="{Loc:Translate Name=AcspetNewpassword}" TextColor="White" Padding="10" />
                <material:TextField Text="{Binding ConfirmPassword}" 
                                    Title="{Loc:Translate Name=AcspetNewpassword}" 
                                    IsPassword="True"  
                                    Margin="25,0,25,0">
                    <material:TextField.Attachments>
                        <material:TextFieldPasswordShowHideAttachment />
                    </material:TextField.Attachments>
                </material:TextField>
                <VerticalStackLayout Spacing="10" Margin="24,10,0,0">

                    
                    <HorizontalStackLayout Spacing="10">

                        <Frame x:Name="LengthFrame"
 WidthRequest="24"
 HeightRequest="24"
 CornerRadius="12"
 BackgroundColor="Red"
 Padding="0"
 HasShadow="False"
 VerticalOptions="Center">

                            <Label x:Name="LengthIcon"
     Text="○"
     TextColor="White"
     FontSize="14"
     HorizontalOptions="Center"
     VerticalOptions="Center"
     HorizontalTextAlignment="Center"
     VerticalTextAlignment="Center"/>
                        </Frame>

                        <Label Text="{Loc:Translate Name=password_min_length}"
 TextColor="White"
 VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- شرط: حرف كبير -->
                    <HorizontalStackLayout Spacing="10">

                        <Frame x:Name="UpperFrame"
 WidthRequest="24"
 HeightRequest="24"
 CornerRadius="12"
 BackgroundColor="Red"
 Padding="0"
 HasShadow="False"
 VerticalOptions="Center">

                            <Label x:Name="UpperIcon"
     Text="○"
     TextColor="White"
     FontSize="14"
     HorizontalOptions="Center"
     VerticalOptions="Center"
     HorizontalTextAlignment="Center"
     VerticalTextAlignment="Center"/>
                        </Frame>

                        <Label Text="{Loc:Translate Name=password_uppercase_required}"
 TextColor="White"
 VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- شرط: رقم -->
                    <HorizontalStackLayout Spacing="10">

                        <Frame x:Name="NumberFrame"
 WidthRequest="24"
 HeightRequest="24"
 CornerRadius="12"
 BackgroundColor="Red"
 Padding="0"
 HasShadow="False"
 VerticalOptions="Center">

                            <Label x:Name="NumberIcon"
     Text="○"
     TextColor="White"
     FontSize="14"
     HorizontalOptions="Center"
     VerticalOptions="Center"
     HorizontalTextAlignment="Center"
     VerticalTextAlignment="Center"/>
                        </Frame>

                        <Label Text="{Loc:Translate Name=password_number_required}"
 TextColor="White"
 VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>
           
        </ScrollView>
        <Button Grid.Row="1"
                x:Name="RegisterButton"
            Text="{Loc:Translate Name=SaveChangFoeMyAccount}"
            HorizontalOptions="Fill"
            Command="{Binding ChangePasswordUserCommand}"
            FontSize="22"
            HeightRequest="50"
            FontFamily="georgia-bold"
            Margin="25"
                VerticalOptions="End"
            TextColor="Black" />
    </Grid>
</ContentPage>