<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="loukupm.View.EditePasswordPage"
             Shell.NavBarIsVisible="False"
               xmlns:Loc="clr-namespace:loukupm.Langue"
             Shell.TabBarIsVisible="False"
               xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             BackgroundColor="#252525"
             Title="EditePasswordPage">
    <Grid>
        <ScrollView>
            <VerticalStackLayout>
                <Grid ColumnDefinitions="*,Auto" HeightRequest="60" BackgroundColor="#202020">
                    <!-- العنوان على اليسار -->
                    <Label Text="{Loc:Translate Name=ChangPassord}"
                   TextColor="White"
                   Margin="24,0,0,0"
                     FontSize="24"
                     FontFamily="georgia-bold"
                     VerticalOptions="Center" />

                    <!-- الزر على اليمين -->
                    <Button Grid.Column="1"
                      WidthRequest="40"
                      HeightRequest="40"
                      CornerRadius="12"
                      ImageSource="backbuttonpmg.png"
                      BackgroundColor="#202020"
                      BorderColor="#999999"
                      Margin="0,0,10,0"            
                      BorderWidth="1"
                     HorizontalOptions="End"
                     VerticalOptions="Center"
                     Clicked="Button_Clicked" />
                </Grid>
                <!-- 🔐 كلمة المرور الحالية (Current Password) -->
                <Label FontSize="16" Margin="12,24,0,0" Text="{Loc:Translate Name=ChangMyPassword1}" TextColor="White" Padding="10" />
                <material:TextField Text="{Binding CurrentPassword}" 
                                    Title="{Loc:Translate Name=ChangMyPassword1}" 
                                    IsPassword="True"  
                                    Margin="25,0,25,0">
                    <material:TextField.Attachments>
                        <material:TextFieldPasswordShowHideAttachment />
                    </material:TextField.Attachments>
                </material:TextField>

                <!-- 🔑 كلمة المرور الجديدة (New Password) -->
                <Label FontSize="16" Margin="12,24,0,0" Text="{Loc:Translate Name=NewMyPassord}" TextColor="White" Padding="10" />
                <material:TextField Text="{Binding Password}" 
                                    Title="{Loc:Translate Name=NewMyPassord}" 
                                    IsPassword="True"  
                                    Margin="25,0,25,0">
                    <material:TextField.Attachments>
                        <material:TextFieldPasswordShowHideAttachment />
                    </material:TextField.Attachments>
                </material:TextField>

                <!-- ✅ تأكيد كلمة المرور الجديدة (Confirm New Password) -->
                <Label FontSize="16" Margin="12,24,0,0" Text="{Loc:Translate Name=AcspetNewpassword}" TextColor="White" Padding="10" />
                <material:TextField Text="{Binding ConfirmPassword}" 
                                    Title="{Loc:Translate Name=AcspetNewpassword}" 
                                    IsPassword="True"  
                                    Margin="25,0,25,0">
                    <material:TextField.Attachments>
                        <material:TextFieldPasswordShowHideAttachment />
                    </material:TextField.Attachments>
                </material:TextField>
                <Button Text="{Loc:Translate Name=SaveChangFoeMyAccount}" Command="{Binding ChangePasswordUserCommand}" FontSize="22" HeightRequest="50" FontFamily="georgia-bold" Margin="25" TextColor="Black" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>