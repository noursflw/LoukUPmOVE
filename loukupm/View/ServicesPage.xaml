<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="loukupm.View.ServicesPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#252525"
             xmlns:Loc="clr-namespace:loukupm.Langue"
             xmlns:converters="clr-namespace:loukupm.Converter"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:sk="clr-namespace:Maui.Skeleton;assembly=Sharpnado.HorusSkeleton.Maui"
             FlowDirection="LeftToRight"
             xmlns:vm="clr-namespace:loukupm.ViewModel"
             Title="ServicesPage">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid>
        <ScrollView   Margin="0,0,0,10" >
            <VerticalStackLayout>
                <Grid ColumnDefinitions="*,Auto" HeightRequest="60" BackgroundColor="#202020">
                 
                    <Label Text="{Loc:Translate Name=AllServies}"
                                      TextColor="White"
                                      Margin="24,0,0,0"
                                      FontSize="24"
                                      FontFamily="georgia-bold"
                                      VerticalOptions="Center" />

                    <Button Grid.Column="1"
         WidthRequest="40"
         HeightRequest="40"
         CornerRadius="12"
         ImageSource="backbuttonpmg.png"
         BackgroundColor="#202020"
         BorderColor="#999999"
         Margin="0,0,10,0"            
         BorderWidth="1"
         HorizontalOptions="End"
         VerticalOptions="Center"
         Clicked="Button_Clicked" />
                </Grid>


                <material:TextField  Margin="25,35,25,0" InputBackgroundColor="#444444" CornerRadius="16"  Icon="search.svg" Title="search"    HeightRequest="56"  />
                <CollectionView x:Name="CategoriesCollectionView"
                ItemsSource="{Binding Categories}" 
                Margin="30,10,10,10">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <ContentView x:Name="FrameContainer" HeightRequest="65"  Padding="0">
                                <Frame x:Name="CategoryFrame"
                       CornerRadius="16"
                       HeightRequest="53"
                       
                       BackgroundColor="#444444"
                       Margin="0,0,0,0"
                       BorderColor="#444444"
                       HasShadow="False"
                       IsClippedToBounds="True">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCategoryTapped" />
                                    </Frame.GestureRecognizers>

                                    <Label Text="{Binding Name}"
                           FontFamily="Oswald"
                           Margin="0,-8,0,0"
                           TextColor="#999999" />
                                </Frame>
                            </ContentView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>





                <HorizontalStackLayout Margin="0,10,10,10">
                    <Frame  IsVisible="{Binding IsServicesLoad}" HeightRequest="55" BorderColor="#444444" WidthRequest="120" Margin="30,0,0,0" CornerRadius="16" BackgroundColor="#444444" sk:Skeleton.IsBusy="{Binding IsCatogory}"  sk:Skeleton.Animation="{sk:DefaultAnimation Fade}"  />
                    <Frame  IsVisible="{Binding IsServicesLoad}" HeightRequest="55" BorderColor="#444444" WidthRequest="120" Margin="17,0,0,0" CornerRadius="16" BackgroundColor="#444444" sk:Skeleton.IsBusy="{Binding IsCatogory}"  sk:Skeleton.Animation="{sk:DefaultAnimation Fade}"  />
                </HorizontalStackLayout>
                <VerticalStackLayout HeightRequest="800">
                    <ScrollView>
                        <VerticalStackLayout >
                            <Frame HeightRequest="122" Margin="20,10,20,0"
                                   WidthRequest="350"
                                   CornerRadius="16" 
                                   BackgroundColor="#444444"
                                   IsVisible="{Binding IsServicesLoad}"
                                   sk:Skeleton.IsBusy="{Binding IsServicesLoad}" 
                                   sk:Skeleton.Animation="{sk:DefaultAnimation Fade}" 
                                   BorderColor="#444444" />
                            <CollectionView ItemsSource="{Binding FilteredServices}" IsVisible="{Binding IsServicesLoad, Converter={StaticResource InverseBoolConverter}}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Margin="24,0,24,0" Spacing="10">
                                            <Frame Margin="3" BorderColor="#444444" BackgroundColor="#444444" CornerRadius="16" HeightRequest="122" >
                                                <Grid ColumnDefinitions="50*,50*">
                                              
                                                    <Label 
        Grid.Column="0"
        Text="{Binding NameServies}" 
        FontFamily="Oswald" 
        TextColor="#D3D3D3" 
        FontSize="18"  />

                                                    <Label  
        Grid.Column="0" 
        Text="{Binding PriceServies}" 
        Margin="0,30,0,0" 
        FontFamily="Oswald" 
        TextColor="#D3D3D3" 
        FontSize="14"  />

                                                    <Label  
        Grid.Column="0" 
        Text="{Binding TimeServies}" 
        Margin="0,55,0,0" 
        FontFamily="Oswald" 
        TextColor="#D3D3D3" 
        FontSize="14"  />


                                                    <Button 
        Grid.Column="1"
        Text="Auswählen"
        TextColor="White"
        BackgroundColor="Black"
        WidthRequest="92"
        HeightRequest="48"
        FontFamily="Oswald"
        FontSize="16"
        CornerRadius="10"
        HorizontalOptions="End"
        VerticalOptions="Start"
        Margin="0,5,5,0"
        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AppViewModel}}, Path=SelectServiceButtonCommand}"
        CommandParameter="{Binding .}" />
                                                </Grid>

                                            </Frame>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                     
                        </VerticalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
             
            </VerticalStackLayout>
        </ScrollView>
        <Button  VerticalOptions="End" 
                 HorizontalOptions="Fill" Text="{Loc:Translate Name=add}" CornerRadius="16" FontSize="16" Clicked="Button_Clicked_2" FontFamily="georgia-bold" TextColor="Black"  Margin="35" />
        <Border Margin="0,20,0,0"
             BackgroundColor="#444444"
             HeightRequest="20"
             VerticalOptions="End" 
             HorizontalOptions="Fill" 
             Stroke="#444444" 
             StrokeShape="RoundRectangle 10,10,0,0" />
    </Grid>

</ContentPage>