<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="loukupm.View.EditPasswordVerification"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:Loc="clr-namespace:loukupm.Langue"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundImageSource="baackgroundpage.png"
             Title="EditPasswordVerification">

    <Grid>
        <ImageButton Source="backbuttonpmg.png"
                     WidthRequest="40"
                     HeightRequest="40"
                     Aspect="AspectFit"
                     BackgroundColor="Transparent"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     Margin="0,48,20,0"
                     Clicked="Button_Clicked"
                     ZIndex="10" />

        <ScrollView>
            <VerticalStackLayout Margin="25,2,2,24">

                <Image Margin="0,80,0,0"
                       WidthRequest="200"
                       HeightRequest="60"
                       Source="slogo.svg"
                       HorizontalOptions="Center" />

                <Label Text="{Loc:Translate Name=ChangPassord}"
                       FontFamily="georgia-bold"
                       Margin="0,24,0,0"
                       FontSize="32"
                       TextColor="#D3D3D3" />

                <Label Text="{Loc:Translate Name=desRestPass}"
                       FontFamily="georgia-bold"
                       Margin="0,8,0,0"
                       FontSize="16"
                       TextColor="#999999" />

                <!-- OTP (same screen as password — per API guide §9) -->
                <Label Text="{Loc:Translate Name=sendotp}"
                       Margin="12,28,0,0"
                       TextColor="White"
                       Padding="10"
                       FontSize="16" />

                <material:TextField x:Name="OtpField"
                                    Keyboard="Numeric"
                                    MaxLength="6"
                                    Title="OTP"
                                    InputBackgroundColor="#444444"
                                    CornerRadius="16"
                                    Margin="12,0,12,0"
                                    HeightRequest="50"
                                    HorizontalOptions="Fill" />

                <Label Text="{Loc:Translate Name=NewMyPassord}"
                       Margin="12,24,0,0"
                       TextColor="White"
                       Padding="10"
                       FontSize="16" />

                <material:TextField x:Name="PasswordField"
                                    Text="{Binding Password, Mode=TwoWay}"
                                    Title="{Loc:Translate Name=NewMyPassord}"
                                    IsPassword="True"
                                    InputBackgroundColor="#444444"
                                    CornerRadius="16"
                                    Margin="12,0,12,0"
                                    HeightRequest="50">
                    <material:TextField.Attachments>
                        <material:TextFieldPasswordShowHideAttachment />
                    </material:TextField.Attachments>
                </material:TextField>

                <Label Text="{Loc:Translate Name=AcspetNewpassword}"
                       Margin="12,24,0,0"
                       TextColor="White"
                       Padding="10"
                       FontSize="16" />

                <material:TextField x:Name="ConfirmPasswordField"
                                    Text="{Binding ConfirmPassword, Mode=TwoWay}"
                                    Title="{Loc:Translate Name=AcspetNewpassword}"
                                    IsPassword="True"
                                    InputBackgroundColor="#444444"
                                    CornerRadius="16"
                                    Margin="12,0,12,0"
                                    HeightRequest="50">
                    <material:TextField.Attachments>
                        <material:TextFieldPasswordShowHideAttachment />
                    </material:TextField.Attachments>
                </material:TextField>

                <Button x:Name="SaveButton"
                        Text="{Loc:Translate Name=SaveChangFoeMyAccount}"
                        Clicked="SavePassword_Clicked"
                        TextColor="#1F1B04"
                        FontSize="22"
                        FontFamily="georgia-bold"
                        BorderWidth="1"
                        CornerRadius="16"
                        HeightRequest="60"
                        Margin="12,50,12,24" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
