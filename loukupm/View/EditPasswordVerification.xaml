<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="loukupm.View.EditPasswordVerification"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:loc="clr-namespace:loukupm.Langue"
             BackgroundColor="#252525"
             BackgroundImageSource="baackgroundpage.png"
             Title="EditPasswordVerification">
    <ScrollView>
        <VerticalStackLayout>
            <Grid>
                <Image Grid.Row="0" Margin="0,10,0,0" WidthRequest="300" HeightRequest="100" Source="slogo.svg"/>
            </Grid>

            <!-- العنوان الرئيسي -->
            <Label Text="{loc:Translate Name=changvaldechen}" FontFamily="georgia-bold" Margin="20,10,0,0" FontSize="28" TextColor="#D3D3D3" />
            
            <!-- النص الثانوي -->
            <Label Text="{loc:Translate Name=ResetPasswordvv}" FontFamily="georgia-bold" Margin="20,10,0,0" FontSize="16" TextColor="#999999" />
            
            <!-- تسمية كلمة المرور الجديدة -->
            <Label Text="{loc:Translate Name=NewMyPassord}" Margin="12,45,0,0" TextColor="White" Padding="10" FontSize="16"/>
            
            <!-- حقل كلمة المرور الجديدة -->
            <material:TextField 
                x:Name="NewPasswordField"
                CornerRadius="16" 
                Text="{Binding NewPassword}" 
                Title="{loc:Translate Name=NewMyPassord}" 
                IsPassword="True" 
                Margin="25,11,25,0" 
                InputBackgroundColor="#444444">
                <material:TextField.Attachments>
                    <material:TextFieldPasswordShowHideAttachment />
                </material:TextField.Attachments>
            </material:TextField>
            
            <!-- تسمية تأكيد كلمة المرور -->
            <Label Text="{loc:Translate Name=NewMyPassord}" Margin="12,11,0,0" TextColor="White" Padding="10" FontSize="16"/>
            
            <!-- حقل تأكيد كلمة المرور -->
            <material:TextField 
                x:Name="ConfirmPasswordField"
                CornerRadius="16" 
                Title="{loc:Translate Name=NewMyPassord}" 
                Text="{Binding ConfirmPassword}" 
                IsPassword="True" 
                Margin="25,11,25,0" 
                InputBackgroundColor="#444444">
                <material:TextField.Attachments>
                    <material:TextFieldPasswordShowHideAttachment />
                </material:TextField.Attachments>
            </material:TextField>

            <!-- الزر مع مؤشر التحميل -->
            <Grid RowDefinitions="Auto" Margin="25,80,25,0" Padding="0">
                <!-- الزر الرئيسي -->
                <Button 
                    x:Name="SavePasswordButton"
                    Grid.Row="0"
                    Clicked="Button_Clicked"
                    TextColor="#1F1B04" 
                    FontSize="22" 
                    FontFamily="georgia-bold"
                    BorderWidth="1" 
                    Text="{loc:Translate Name=ChangePasswordCommand}" 
                    CornerRadius="16"
                    IsEnabled="True" />

                <!-- مؤشر التحميل -->
                <ActivityIndicator 
                    x:Name="LoadingIndicator"
                    Grid.Row="0"
                    IsRunning="False"
                    IsVisible="False"
                    Color="#EBD750"
                    Scale="1.2"
                    VerticalOptions="Center"
                    HorizontalOptions="Center" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>