<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="loukupm.View.NotifictionPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             xmlns:Loc="clr-namespace:loukupm.Langue"
             xmlns:converters="clr-namespace:loukupm.Converter"
             BackgroundColor="#252525"
             xmlns:sk="clr-namespace:Maui.Skeleton;assembly=Sharpnado.HorusSkeleton.Maui"
             FlowDirection="LeftToRight"
             Title="NotifictionPage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="60,*" BackgroundColor="#252525">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" HeightRequest="60" BackgroundColor="#202020">
            <!-- Title -->
            <Label Text="{Loc:Translate Name=Benachrichtigungen}"
                 TextColor="White"
                 Margin="24,0,0,0"
                 FontSize="24"
                 FontFamily="georgia-bold"
                 VerticalOptions="Center" />

            <!-- Back Button -->
            <Button Grid.Column="1"
                 WidthRequest="40"
                 HeightRequest="40"
                 CornerRadius="12"
                 ImageSource="backbuttonpmg.png"
                 BackgroundColor="#202020"
                 BorderColor="#999999"
                 Margin="0,0,10,0"            
                 BorderWidth="1"
                 HorizontalOptions="End"
                 VerticalOptions="Center"
                 Clicked="Button_Clicked" />
        </Grid>

        <!-- Content Area with RefreshView -->
        <RefreshView Grid.Row="1" 
                     Command="{Binding LoadNotificationsCommand}"
                     IsRefreshing="{Binding IsRefreshing}"
                     RefreshColor="#FFFFFF"
                     BackgroundColor="#252525">
            <Grid RowDefinitions="*" ColumnDefinitions="*" BackgroundColor="#252525">
                <!-- Loading Skeleton - Shows while loading notifications -->
                <VerticalStackLayout Grid.Row="0" IsVisible="{Binding IsLoading}" Margin="16,10,16,0" Spacing="8" Padding="0">
                    <Frame HeightRequest="100" CornerRadius="12" BackgroundColor="#444444" 
                           sk:Skeleton.IsBusy="{Binding IsLoading}" 
                           sk:Skeleton.Animation="{sk:DefaultAnimation Fade}" 
                           BorderColor="#444444" Margin="0,4,0,4" Padding="0" />

                    <Frame HeightRequest="100" CornerRadius="12" BackgroundColor="#444444" 
                           sk:Skeleton.IsBusy="{Binding IsLoading}" 
                           sk:Skeleton.Animation="{sk:DefaultAnimation Fade}" 
                           BorderColor="#444444" Margin="0,4,0,4" Padding="0" />

                    <Frame HeightRequest="100" CornerRadius="12" BackgroundColor="#444444" 
                           sk:Skeleton.IsBusy="{Binding IsLoading}" 
                           sk:Skeleton.Animation="{sk:DefaultAnimation Fade}" 
                           BorderColor="#444444" Margin="0,4,0,4" Padding="0" />
                </VerticalStackLayout>

                <!-- Notifications List Container -->
                <VerticalStackLayout Grid.Row="0" IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" 
                                    Padding="0" Spacing="0" BackgroundColor="#252525">

                    <!-- Empty State -->
                    <VerticalStackLayout IsVisible="{Binding Notifications.Count, Converter={converters:InverseBoolConverter}}" 
                                        HorizontalOptions="Center" VerticalOptions="Center" Margin="20" Padding="20">
                        <Label Text="No Notifications"
                               TextColor="#999999" FontSize="18" HorizontalTextAlignment="Center"/>
                        <Label Text="Pull down to refresh"
                               TextColor="#666666" FontSize="14" HorizontalTextAlignment="Center" Margin="0,10,0,0"/>
                    </VerticalStackLayout>

                    <!-- Notifications CollectionView -->
                    <CollectionView ItemsSource="{Binding Notifications}" 
                                   IsVisible="{Binding Notifications.Count}"
                                   SelectionMode="None"
                                   Margin="0"
                                   BackgroundColor="#252525">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="#303030" BorderColor="#404040" 
                                       HasShadow="False" CornerRadius="12" Margin="16,8" Padding="0">
                                    <VerticalStackLayout Spacing="6" Padding="12">
                                        <!-- Date and Time Row -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <!-- Date Column -->
                                            <Label Text="{Binding FormattedDate}" 
                                                   TextColor="#999999" FontSize="12" Grid.Column="0"
                                                   VerticalTextAlignment="Center"/>
                                            <!-- Time Column --><!--
                                            <Label Text="{Binding FormattedTime}" 
                                                   TextColor="#999999" FontSize="12" Grid.Column="1"
                                                   VerticalTextAlignment="Center"/>-->
                                        </Grid>

                                        <!-- Title (Bold) -->
                                        <Label Text="{Binding Title}" 
                                               TextColor="#FFFFFF" FontSize="16" FontFamily="georgia-bold"
                                               LineBreakMode="TailTruncation" MaxLines="2" Margin="0,6,0,0"/>

                                        <!-- Message -->
                                        <Label Text="{Binding Message}" 
                                               TextColor="#D3D3D3" FontSize="13" LineBreakMode="WordWrap"
                                               Margin="0,4,0,0"/>

                                        <!-- Relative Time and Read Status -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,6,0,0">
                                            <Label Text="" 
                                                   TextColor="#777777" FontSize="11" Grid.Column="0"
                                                   VerticalTextAlignment="Center"/>
                                           
                                        </Grid>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Grid>
        </RefreshView>
    </Grid>
</ContentPage>