<?xml version="1.0" encoding="utf-8" ?>
<mauiPopup:BasePopupPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mauiPopup="clr-namespace:MauiPopup.Views;assembly=MauiPopup"
  
    x:Class="loukupm.View.MyCustomPopup">

    <Grid  BackgroundColor="#00000000">
        <!-- شفافة تمامًا -->
        <Frame BackgroundColor="#333333"
               CornerRadius="20"
               Padding="20"
              Background="#00000000"
               
               HasShadow="True"
               WidthRequest="300"
               HeightRequest="200"
               HorizontalOptions="Center"
               VerticalOptions="Center">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="هذه رسالة مخصصة"
                       TextColor="White"
                       HorizontalOptions="Center"/>
                
            </VerticalStackLayout>
        </Frame>
    </Grid>
</mauiPopup:BasePopupPage>
