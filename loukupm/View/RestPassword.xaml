<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="loukupm.View.RestPassword"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             BackgroundImageSource="baackgroundpage.png"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="RestPassword">
    <ScrollView>
        <VerticalStackLayout Margin="25,2,2,24">
            <Grid RowDefinitions="40*,60*"  >
                <Image Grid.Row="0" Margin="0,100,0,0" WidthRequest="200" HeightRequest="60" Source="slogo.svg"/>
             
            </Grid>
            <Label Text="Passwort vergessen" FontFamily="georgia-bold" Margin="0,10,0,0" FontSize="32" TextColor="#D3D3D3" />
            <Label Text="Bitte geben Sie Ihre E-Mail-Adresse ein, um Anweisungen zum Zurücksetzen Ihres Passworts zu erhaltenn" FontFamily="georgia-bold" Margin="0,10,0,0" FontSize="16" TextColor="#999999" />
            <Label Text="E-Mail" Margin="12,5,0,0"  TextColor="White" Padding="10" FontSize="16"/>
            <material:TextField  Margin="12,0,30,0" InputBackgroundColor="#444444" CornerRadius="16"  Icon="email.png"     HeightRequest="50" Title="Example@gmail.com" />
            
            
            
            <Button  
   Clicked="Button_Clicked"    TextColor="#1F1B04" FontSize="22" FontFamily="georgia-bold"
   BorderWidth="1" Text="Link senden" CornerRadius="16"
   HeightRequest="60" Margin="12,50,25,25"  />
           

           

        </VerticalStackLayout>
       
    </ScrollView>
</ContentPage>