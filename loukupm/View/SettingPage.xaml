<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="loukupm.View.SettingPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0A0A0A"
              Shell.TabBarIsVisible="False"
             xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
             xmlns:Loc="clr-namespace:loukupm.Langue"
             Title="SettingPage">
    <VerticalStackLayout Spacing="30" Margin="0,0,0,0">
        <Grid ColumnDefinitions="*,Auto" HeightRequest="60" BackgroundColor="#0A0A0A">
            <!-- العنوان على اليسار -->
            <Label Text="{Loc:Translate Name=setting}"
    TextColor="White"
    Margin="24,0,0,0"
      FontSize="24"
      FontFamily="georgia-bold"
      VerticalOptions="Center" />

            <!-- الزر على اليمين -->
            <Button Grid.Column="1"
       WidthRequest="40"
       HeightRequest="40"
       CornerRadius="12"
       ImageSource="backbuttonpmg.png"
       BackgroundColor="#0A0A0A"
       BorderColor="#0A0A0A"
       Margin="0,0,10,0"            
       BorderWidth="1"
      HorizontalOptions="End"
      VerticalOptions="Center"
      Clicked="Button_Clicked_1" />
        </Grid>
       
        <uranium:Dropdown 
            CornerRadius="12"
            HeightRequest="40"
            BackgroundColor="#181c21"
            Placeholder="Choose Language"
            ItemsSource="{Binding Languages}"
            SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
            Margin="24,0,24,0" />

        <!-- Notifications ON/OFF Switch -->
        <Frame BackgroundColor="#181c21" CornerRadius="12" Margin="24,0,24,0" Padding="16" HasShadow="False">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <Label Grid.Column="0"
                       Text="Notifications"
                       TextColor="White"
                       FontSize="16"
                       FontFamily="georgia"
                       VerticalOptions="Center" />

                <Switch Grid.Column="1"
                        x:Name="NotificationsSwitch"
                        VerticalOptions="Center"
                        Toggled="OnNotificationsSwitchToggled" />
            </Grid>
        </Frame>
    </VerticalStackLayout>
</ContentPage>