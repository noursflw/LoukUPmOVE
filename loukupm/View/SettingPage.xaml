<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="loukupm.View.SettingPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0A0A0A"
              Shell.TabBarIsVisible="False"
             xmlns:uranium="http://schemas.enisn-projects.io/dotnet/maui/uraniumui"
             xmlns:Loc="clr-namespace:loukupm.Langue"
             Title="SettingPage">
    <VerticalStackLayout Spacing="30" Margin="0,0,0,0">
        <Grid ColumnDefinitions="*,Auto" HeightRequest="60" BackgroundColor="#0A0A0A">
            <!-- العنوان على اليسار -->
            <Label Text="{Loc:Translate Name=setting}"
    TextColor="White"
    Margin="24,0,0,0"
      FontSize="24"
      FontFamily="georgia-bold"
      VerticalOptions="Center" />

            <!-- الزر على اليمين -->
            <Button Grid.Column="1"
       WidthRequest="40"
       HeightRequest="40"
       CornerRadius="12"
       ImageSource="backbuttonpmg.png"
       BackgroundColor="#0A0A0A"
       BorderColor="#0A0A0A"
       Margin="0,0,10,0"            
       BorderWidth="1"
      HorizontalOptions="End"
      VerticalOptions="Center"
      Clicked="Button_Clicked_1" />
        </Grid>

        <Label Margin="30,0,0,0" TextColor="#999" Text="{Loc:Translate Name=SettingLang}"/>
        <uranium:Dropdown 
            CornerRadius="12"
            HeightRequest="40"
            BackgroundColor="#181c21"
            TextColor="#D4AF37"
            Placeholder="Choose Language"
            ItemsSource="{Binding Languages}"
            SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
            Margin="24,0,24,0" />
        <Label Margin="30,0,0,0" TextColor="#999" Text="{Loc:Translate Name=SettingNottivcation}"/>

        <Frame BorderColor="#181c21" BackgroundColor="#181c21" CornerRadius="12" Margin="24,0,24,0" Padding="16" HasShadow="False">
            <VerticalStackLayout>

                <!-- Notifications Main -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                    <VerticalStackLayout Grid.Column="0">
                        <Label 
                Text="{Loc:Translate Name=Benachrichtigungen}"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold"
                FontFamily="georgia"/>

                        <Label 
                Text="{Loc:Translate Name=DesNotfction}"
                TextColor="#999"
                FontSize="13"/>
                    </VerticalStackLayout>

                    <Switch 
            Grid.Column="1"
            OnColor="#D4AF37"
            x:Name="NotificationsSwitch"
            Toggled="OnNotificationsSwitchToggled"/>
                </Grid>

                <!-- separator -->
                <BoxView HeightRequest="1"
             Color="#999"
             Opacity="0.2"
             Margin="0,12"/>

                <!-- SMS -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                    <VerticalStackLayout>
                        <Label 
                           Text="{Loc:Translate Name=SMSNotifications}"
                           TextColor="White"
                           FontSize="16"
                           VerticalOptions="Center"/>
                        <Label 
                             Text="{Loc:Translate Name=DesSms}"
                             TextColor="#999"
                             FontSize="13"/>
                    </VerticalStackLayout>

                    <Switch Grid.Column="1"
                            OnColor="#D4AF37"
                IsToggled="{Binding SmsEnabled}"/>
                </Grid>

                <!-- separator -->
                <BoxView HeightRequest="1"
             Color="#999"
             Opacity="0.2"
             Margin="0,12"/>

                <!-- Email -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                    <VerticalStackLayout>
                        <Label 
Text="{Loc:Translate Name=EmailNotifications}"
TextColor="White"
FontSize="16"
VerticalOptions="Center"/>
                        <Label 
     Text="{Loc:Translate Name=DesEmai}"
     TextColor="#999"
     FontSize="13"/>
                    </VerticalStackLayout>

                    <Switch Grid.Column="1"
                OnColor="#D4AF37"
                IsToggled="{Binding EmailEnabled}"/>
                </Grid>

            </VerticalStackLayout>
        </Frame>
    </VerticalStackLayout>
</ContentPage>