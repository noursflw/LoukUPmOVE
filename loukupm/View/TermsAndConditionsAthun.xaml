<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="loukupm.View.TermsAndConditionsAthun"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converter="clr-namespace:loukupm.Converter"
             BackgroundImageSource="baackgroundpage.png"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             xmlns:loc="clr-namespace:loukupm.Langue"
             Title="">
    <Grid RowDefinitions="Auto,*" BackgroundColor="#0A0A0A">
        <!-- Header -->
        <Frame Grid.Row="0"
            BackgroundColor="#0A0A0A"
            BorderColor="Transparent"
            CornerRadius="0"
            Padding="20"
            Margin="0">
            <Label Text="{loc:Translate Name=TermsandConditions}"
                HorizontalOptions="Center"
                FontSize="26"
                FontAttributes="Bold"
                TextColor="#EBD750" />
        </Frame>

        <!-- Main Content Area with RefreshView -->
        <Grid Grid.Row="1" RowDefinitions="*" BackgroundColor="#0A0A0A">

            <!-- Loading State -->
            <VerticalStackLayout x:Name="LoadingIndicator"
                              VerticalOptions="CenterAndExpand"
                              HorizontalOptions="FillAndExpand"
                              Padding="20"
                              Spacing="20"
                              BackgroundColor="#0A0A0A"
                              IsVisible="{Binding IsLoading}">
                <Label Text="Loading Terms and Conditions..."
                    FontSize="16"
                    TextColor="White"
                    HorizontalOptions="Center" />
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                IsVisible="{Binding IsLoading}"
                                Color="#EBD750"
                                Scale="1.5"
                                HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- RefreshView for Pull-to-Refresh + Content -->
            <RefreshView x:Name="RefreshView"
                      Command="{Binding RetryLoadTermsAndConditionsCommand}"
                      IsRefreshing="{Binding IsLoading}"
                      RefreshColor="#EBD750"
                      BackgroundColor="#0A0A0A"
                      IsVisible="{Binding IsLoading, Converter={toolkit:InvertedBoolConverter}, ConverterParameter=false}">
                <Grid RowDefinitions="*" BackgroundColor="#0A0A0A">

                    <!-- Content ScrollView (shown when CmsData is available) -->
                    <ScrollView BackgroundColor="#0A0A0A"
                             IsVisible="{Binding CmsData, Converter={toolkit:IsNotNullConverter}}">
                        <VerticalStackLayout Padding="20" Spacing="15">
                            <!-- Dynamic Content Blocks using BindableLayout -->
                            <VerticalStackLayout>
                                <BindableLayout.ItemsSource>
                                    <Binding Path="CmsData.Blocks" />
                                </BindableLayout.ItemsSource>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="15">
                                            <!-- Heading Block -->
                                            <Frame Margin="5" IsVisible="{Binding Type, Converter={converter:StringEqualsConverter}, ConverterParameter=heading}"
                                                BorderColor="#EBD750"
                                                BackgroundColor="#0A0A0A"
                                                CornerRadius="16"
                                                Padding="15"
                                                HasShadow="True">
                                                <Label Text="{Binding Content.Text}"
                                                    FontSize="20"
                                                    FontAttributes="Bold"
                                                    TextColor="#EBD750"
                                                    LineBreakMode="WordWrap" />
                                            </Frame>

                                            <!-- Paragraph Block -->
                                            <Frame Margin="5" IsVisible="{Binding Type, Converter={converter:StringEqualsConverter}, ConverterParameter=paragraph}"
                                                BorderColor="#444444"
                                                BackgroundColor="#0A0A0A"
                                                CornerRadius="16"
                                                Padding="15"
                                                HasShadow="True">
                                                <Label Text="{Binding Content.Text}"
                                                    FontSize="14"
                                                    TextColor="White"
                                                    LineBreakMode="WordWrap" />
                                            </Frame>




                                            <!-- Unordered List Block -->
                                            <Frame Margin="5" IsVisible="{Binding Type, Converter={converter:StringEqualsConverter}, ConverterParameter=unordered_list}"
                                                BorderColor="#444444"
                                                BackgroundColor="#0A0A0A"
                                                CornerRadius="20"
                                                Padding="15"
                                                HasShadow="True">
                                                <VerticalStackLayout Spacing="8">
                                                    <BindableLayout.ItemsSource>
                                                        <Binding Path="Content.Items" />
                                                    </BindableLayout.ItemsSource>
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <HorizontalStackLayout Spacing="10" Padding="5,0">
                                                                <Label Text="•"
                                                                    FontSize="14"
                                                                    TextColor="#EBD750"
                                                                    VerticalOptions="Start" />
                                                                <Label Text="{Binding}"
                                                                    FontSize="13"
                                                                    TextColor="White"
                                                                    LineBreakMode="WordWrap" />
                                                            </HorizontalStackLayout>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </Frame>

                                            <!-- Warning Box Block -->
                                            <Frame IsVisible="{Binding Type, Converter={converter:StringEqualsConverter}, ConverterParameter=warning_box}"
                                                BorderColor="#FFD700"
                                                BackgroundColor="#0A0A0A"
                                                CornerRadius="16"
                                                Padding="15"
                                                HasShadow="True">
                                                <VerticalStackLayout Spacing="5">
                                                    <Label Text="⚠️ Warning"
                                                        FontSize="14"
                                                        FontAttributes="Bold"
                                                        TextColor="#FFD700" />
                                                    <Label Text="{Binding Content.Text}"
                                                        FontSize="13"
                                                        TextColor="White"
                                                        LineBreakMode="WordWrap" />
                                                </VerticalStackLayout>
                                            </Frame>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>


                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Empty State (no data loaded yet, no error) -->
                    <VerticalStackLayout IsVisible="{Binding CmsData, Converter={toolkit:IsNullConverter}}"
                                     Padding="20"
                                     Spacing="20"
                                     VerticalOptions="CenterAndExpand"
                                     HorizontalOptions="FillAndExpand">
                        <Label Text="No Content Available"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="#EBD750"
                            HorizontalOptions="Center" />
                        <Label Text="Pull down to refresh"
                            FontSize="12"
                            TextColor="#AAAAAA"
                            HorizontalOptions="Center" />
                        <Button Text="Refresh Now"
                             Command="{Binding RetryLoadTermsAndConditionsCommand}"
                             BackgroundColor="#EBD750"
                             TextColor="#1a1a1a"
                             Padding="10"
                             CornerRadius="8"
                             FontSize="14"
                             FontAttributes="Bold"
                             WidthRequest="150"
                             HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Error State (shown when HasError is true) -->
                    <VerticalStackLayout IsVisible="{Binding HasError}"
                                     Padding="20"
                                     Spacing="15"
                                     VerticalOptions="CenterAndExpand"
                                     HorizontalOptions="FillAndExpand">
                        <Frame BorderColor="#FF6B6B"
                            BackgroundColor="#3A2A2A"
                            CornerRadius="16"
                            Padding="20"
                            HasShadow="True">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="⚠️ Error Loading Content"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="#FF6B6B" />
                                <Label Text="{Binding ErrorMessage}"
                                    FontSize="14"
                                    TextColor="White"
                                    LineBreakMode="WordWrap" />
                                <Label Text="Pull down to try again"
                                    FontSize="12"
                                    TextColor="#AAAAAA" />
                                <Button Text="Retry"
                                     Command="{Binding RetryLoadTermsAndConditionsCommand}"
                                     BackgroundColor="#EBD750"
                                     TextColor="#1a1a1a"
                                     Padding="10"
                                     CornerRadius="8"
                                     FontSize="14"
                                     FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>
                </Grid>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>