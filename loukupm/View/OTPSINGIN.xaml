<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="loukupm.View.OTPSINGIN"
             xmlns:loc="clr-namespace:loukupm.Langue"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#202020"
             NavigationPage.HasNavigationBar="False"
             BackgroundImageSource="baackgroundpage.png"
             Title="{loc:Translate Name=OtpSigninTitle}">

    <Grid Padding="24,12,24,8"
          RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="8">

        <Image Grid.Row="0"
               WidthRequest="120"
               HeightRequest="52"
               Source="slogo.svg"
               HorizontalOptions="Center"
               Margin="0,4,0,0"/>

        <VerticalStackLayout Grid.Row="1"
                             Spacing="4"
                             HorizontalOptions="Fill">
            <Label FontSize="22"
                   FontFamily="georgia-bold"
                   Text="{loc:Translate Name=OtpSigninVerifyAccount}"
                   TextColor="#A8883C"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>

            <BoxView HeightRequest="2"
                     WidthRequest="120"
                     Color="#A8883C"
                     HorizontalOptions="Center"
                     Margin="0,2,0,2"/>

            <Label FontSize="13"
                   Text="{loc:Translate Name=OtpSigninEnterCode}"
                   TextColor="White"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"/>

            <Label x:Name="MaskedDestinationLabel"
                   FontSize="15"
                   FontFamily="georgia-bold"
                   Text="a***@mail.com"
                   TextColor="#A8883C"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="TailTruncation"/>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="2"
                             Spacing="10"
                             VerticalOptions="Center"
                             HorizontalOptions="Fill">
            <Border Stroke="#A8883C"
                    StrokeThickness="1"
                    BackgroundColor="Transparent"
                    Padding="12,2"
                    HeightRequest="52">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Entry x:Name="OtpEntry"
                       Placeholder="000000"
                       PlaceholderColor="#666666"
                       TextColor="White"
                       BackgroundColor="Transparent"
                       FontSize="22"
                       FontFamily="georgia-bold"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center"
                       MaxLength="6"
                       Keyboard="Numeric"
                       TextChanged="OnOtpTextChanged"/>
            </Border>

            <Grid HeightRequest="48">
                <Button x:Name="VerifyButton"
                        Text="{loc:Translate Name=OtpSigninVerify}"
                        BackgroundColor="#A8883C"
                        TextColor="White"
                        FontFamily="Oswald"
                        FontSize="16"
                        CornerRadius="12"
                        Padding="16,0"
                        IsEnabled="False"
                        Clicked="OnVerifyClicked"
                        HeightRequest="48"/>

                <Grid x:Name="LoadingGrid"
                      IsVisible="False"
                      BackgroundColor="#A8883C">
                    <ActivityIndicator x:Name="LoadingIndicator"
                                       IsRunning="True"
                                       IsVisible="True"
                                       Color="White"
                                       Scale="1.1"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center"/>
                </Grid>
            </Grid>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="3"
                             Spacing="8"
                             Margin="0,0,0,4">
            <BoxView HeightRequest="1"
                     Color="#444444"/>

            <Label FontSize="12"
                   Text="{loc:Translate Name=OtpSigninDidntReceive}"
                   TextColor="White"
                   HorizontalOptions="Center"/>

            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <Button x:Name="ResendButton"
                        Grid.Column="0"
                        Text="{loc:Translate Name=OtpSigninResend}"
                        BackgroundColor="Transparent"
                        TextColor="#A8883C"
                        FontFamily="Oswald"
                        FontSize="14"
                        BorderColor="#A8883C"
                        BorderWidth="1"
                        CornerRadius="10"
                        Padding="12,0"
                        Clicked="OnResendClicked"
                        HeightRequest="42"/>

                <Label x:Name="TimerLabel"
                       Grid.Column="1"
                       Text="60s"
                       TextColor="#A8883C"
                       FontFamily="georgia-bold"
                       FontSize="14"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       IsVisible="False"
                       WidthRequest="44"/>
            </Grid>

            <Button Text="{loc:Translate Name=OtpSigninBack}"
                    BackgroundColor="Transparent"
                    TextColor="Gray"
                    FontFamily="Oswald"
                    FontSize="13"
                    Clicked="OnBackClicked"
                    CornerRadius="8"
                    Padding="12,0"
                    HeightRequest="36"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
