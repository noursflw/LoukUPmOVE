<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:Loc="clr-namespace:loukupm.Langue"
               x:Class="loukupm.View.MassgingApp.PasswordResetSuccessPopup"
               Color="Transparent">
    <Frame BackgroundColor="#444444"
           CornerRadius="20"
           HasShadow="True"
           Padding="0"
           BorderColor="#444444"
           HorizontalOptions="Center"
           VerticalOptions="Center">

        <VerticalStackLayout Padding="24"
                             Spacing="16"
                             HorizontalOptions="Center"
                             WidthRequest="320"
                             VerticalOptions="Center">

            <Label Text="{Loc:Translate Name=Sacsess}"
                   FontFamily="georgia-bold"
                   FontSize="22"
                   HorizontalOptions="Center"
                   TextColor="#EBD750"
                   HorizontalTextAlignment="Center" />

            <Image Source="password_reset_success.svg"
                   HeightRequest="140"
                   WidthRequest="140"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />

            <Label Text="{Loc:Translate Name=Passwordupdatedsuccessfully}"
                   FontFamily="georgia-bold"
                   FontSize="16"
                   HorizontalOptions="Center"
                   TextColor="White"
                   HorizontalTextAlignment="Center" />

            <Button Text="{Loc:Translate Name=yes}"
                    BorderWidth="1"
                    TextColor="#1F1B04"
                    CornerRadius="10"
                    HeightRequest="44"
                    FontFamily="georgia-bold"
                    Clicked="Ok_Clicked" />
        </VerticalStackLayout>
    </Frame>
</toolkit:Popup>
