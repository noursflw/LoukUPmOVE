<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="loukupm.View.MassgingApp.SuccessfullyBookingNow"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
              Color="Transparent"
             xmlns:Loc="clr-namespace:loukupm.Langue">
    <Frame
      BackgroundColor="#000000"
      CornerRadius="20"
      HasShadow="True"
      Padding="0"
      BorderColor="#444444"
      HorizontalOptions="Center"
      VerticalOptions="Center">

        <VerticalStackLayout
          Padding="20"
          Spacing="18"
          HorizontalOptions="Center"
          WidthRequest="320"
          VerticalOptions="Center">
            <Image
      Source="sucsessbokkignow"
      HeightRequest="120"
      WidthRequest="200"  
      Aspect="AspectFit"
      HorizontalOptions="Center" />


            <Label
     Text="{Loc:Translate Name=Bookingsuccessful}"
     FontAttributes="Bold"
     FontSize="20"           
     HorizontalOptions="Center"
     TextColor="White"
     HorizontalTextAlignment="Center" />

            <Label
Text="{Loc:Translate Name=Appointmentbookedsuccessfully}"
HorizontalOptions="Center"
FontSize="12"                
TextColor="#C0C0C0"
HorizontalTextAlignment="Center" />

            <Button
         Text="{Loc:Translate Name=ViewAppointment}"
         BorderWidth="1"
         TextColor="Black"
         CornerRadius="10"
         HeightRequest="44"
         FontFamily="georgia"                        
         Clicked="Button_Clicked" />
        </VerticalStackLayout>
    </Frame>
</toolkit:Popup>