<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="loukupm.View.MassgingApp.paslen"
            xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
            xmlns:Loc="clr-namespace:loukupm.Langue" >
    <Frame
           BackgroundColor="#444444"
           CornerRadius="20"
           HasShadow="True"
           Padding="0"
           BorderColor="#444444"
           WidthRequest="320"
           HorizontalOptions="Center"
           VerticalOptions="Center">
        <VerticalStackLayout>
            <Frame BackgroundColor="Transparent" BorderColor="Transparent" CornerRadius="20" Margin="0,-8,0,0" Opacity="0.66"  >
                <Label 
           Text="{Loc:Translate Name=EroreInput}" 
           HorizontalOptions="Center" 
           VerticalOptions="Center" 
            TextColor="White"
           FontAttributes="Bold"/>
            </Frame>

            <VerticalStackLayout Margin="0,10,0,0">
                <Image
              Source="paslenght.svg"
              HeightRequest="220"
              Aspect="AspectFit"
              HorizontalOptions="Center"/>
                <Label
           Text="{Loc:Translate Name=pasl}"
              FontAttributes="Bold"
              HorizontalOptions="Center" 
              Margin="0,30,0,0"
              TextColor="White"
             HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
            <Button FontFamily="georgia-bold" FontSize="19"  BackgroundColor="#EBD750" Margin="10" TextColor="Black" BorderWidth="1" Clicked="CancelClicked"   Text="{Loc:Translate Name=yes}"/>
        </VerticalStackLayout>

    </Frame>
</toolkit:Popup>