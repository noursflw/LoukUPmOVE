<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converter="clr-namespace:loukupm.Converter"
             x:Class="loukupm.View.PolicyandPrivacyPage"
             BackgroundImageSource="baackgroundpage.png"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             xmlns:loc="clr-namespace:loukupm.Langue"
             Title="">

    <Grid RowDefinitions="Auto,*" BackgroundColor="#252525">
        <!-- Header -->
        <Frame Grid.Row="0"
               BackgroundColor="#202020"
               BorderColor="Transparent"
               CornerRadius="0"
               Padding="20"
               Margin="0">
            <Label Text="{loc:Translate Name=PolicyandPrivacy}"
                   HorizontalOptions="Center"
                   FontSize="26"
                   FontAttributes="Bold"
                   TextColor="#EBD750" />
        </Frame>

        <!-- Main Content Area with RefreshView -->
        <Grid Grid.Row="1" RowDefinitions="*" BackgroundColor="#252525">

            <!-- Loading State -->
            <VerticalStackLayout x:Name="LoadingIndicator"
                                 VerticalOptions="CenterAndExpand"
                                 HorizontalOptions="FillAndExpand"
                                 Padding="20"
                                 Spacing="20"
                                 BackgroundColor="#252525"
                                 IsVisible="{Binding IsLoading}">
                <Label Text="Loading Privacy Policy..."
                       FontSize="16"
                       TextColor="White"
                       HorizontalOptions="Center" />
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="#EBD750"
                                   Scale="1.5"
                                   HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- RefreshView for Pull-to-Refresh + Content -->
            <RefreshView x:Name="RefreshView"
                         Command="{Binding RetryLoadPrivacyPolicyCommand}"
                         IsRefreshing="{Binding IsLoading}"
                         RefreshColor="#EBD750"
                         BackgroundColor="#252525"
                         IsVisible="{Binding IsLoading, Converter={toolkit:InvertedBoolConverter}, ConverterParameter=false}">
                <Grid RowDefinitions="*" BackgroundColor="#252525">

                    <!-- Content ScrollView (shown when CmsData is available) -->
                    <ScrollView BackgroundColor="#252525"
                                IsVisible="{Binding CmsData, Converter={toolkit:IsNotNullConverter}}">
                        <VerticalStackLayout Padding="20" Spacing="15" FlowDirection="{Binding ContentFlowDirection}">
                            <!-- Dynamic Content Blocks using BindableLayout -->
                            <VerticalStackLayout>
                                <BindableLayout.ItemsSource>
                                    <Binding Path="CmsData.Blocks" />
                                </BindableLayout.ItemsSource>
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="15">
                                            <!-- Heading Block -->
                                            <Frame Margin="5" IsVisible="{Binding Type, Converter={converter:StringEqualsConverter}, ConverterParameter=heading}"
                                                   BorderColor="#444444"
                                                   BackgroundColor="#2A2A2A"
                                                   CornerRadius="16"
                                                   Padding="15"
                                                   HasShadow="True">
                                                <Label Text="{Binding Content.Text}"
                                                       FontSize="20"
                                                       FontAttributes="Bold"
                                                       TextColor="#EBD750"
                                                       LineBreakMode="WordWrap" />
                                            </Frame>

                                            <!-- Paragraph Block -->
                                            <Frame Margin="5" IsVisible="{Binding Type, Converter={converter:StringEqualsConverter}, ConverterParameter=paragraph}"
                                                   BorderColor="#444444"
                                                   BackgroundColor="#2A2A2A"
                                                   CornerRadius="16"
                                                   Padding="15"
                                                   HasShadow="True">
                                                <Label Text="{Binding Content.Text}"
                                                       FontSize="14"
                                                       TextColor="White"
                                                       LineBreakMode="WordWrap" />
                                            </Frame>

                                            <!-- Title Paragraph Block -->
                                            <Frame Margin="5" IsVisible="{Binding Type, Converter={converter:StringEqualsConverter}, ConverterParameter=title_paragraph}"
                                                   BorderColor="#444444"
                                                   BackgroundColor="#2A2A2A"
                                                   CornerRadius="16"
                                                   Padding="15"
                                                   HasShadow="True">
                                                <VerticalStackLayout Spacing="10">
                                                    <Label Text="{Binding Content.Title}"
                                                           FontSize="16"
                                                           FontAttributes="Bold"
                                                           TextColor="#D3D3D3" />
                                                    <Label Text="{Binding Content.Text}"
                                                           FontSize="13"
                                                           TextColor="White"
                                                           LineBreakMode="WordWrap" />
                                                </VerticalStackLayout>
                                            </Frame>

                                            <!-- Unordered List Block -->
                                            <Frame Margin="5" IsVisible="{Binding Type, Converter={converter:StringEqualsConverter}, ConverterParameter=unordered_list}"
                                                   BorderColor="#444444"
                                                   BackgroundColor="#2A2A2A"
                                                   CornerRadius="16"
                                                   Padding="15"
                                                   HasShadow="True">
                                                <VerticalStackLayout Spacing="8">
                                                    <BindableLayout.ItemsSource>
                                                        <Binding Path="Content.Items" />
                                                    </BindableLayout.ItemsSource>
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate>
                                                            <Label Text="{Binding ., StringFormat='• {0}'}"
                                                                   FontSize="13"
                                                                   TextColor="White"
                                                                   LineBreakMode="WordWrap" />
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </VerticalStackLayout>
                                            </Frame>

                                            <!-- Divider Block -->
                                            <BoxView IsVisible="{Binding Type, Converter={converter:StringEqualsConverter}, ConverterParameter=divider}"
                                                     HeightRequest="1"
                                                     BackgroundColor="#444444"
                                                     Margin="5,10" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Error State -->
                    <VerticalStackLayout IsVisible="{Binding HasError}"
                                         VerticalOptions="CenterAndExpand"
                                         HorizontalOptions="FillAndExpand"
                                         Padding="20"
                                         Spacing="20"
                                         BackgroundColor="#252525">
                        <Label Text="Unable to load Privacy Policy"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#EBD750"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding ErrorMessage}"
                               FontSize="14"
                               TextColor="White"
                               LineBreakMode="WordWrap"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Retry"
                                Command="{Binding RetryLoadPrivacyPolicyCommand}"
                                BackgroundColor="#EBD750"
                                TextColor="#252525"
                                CornerRadius="16"
                                Padding="20,10"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                WidthRequest="120" />
                    </VerticalStackLayout>

                </Grid>
            </RefreshView>

        </Grid>
    </Grid>

</ContentPage>
