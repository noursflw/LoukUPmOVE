<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="loukupm.View.BookingPage"
             Shell.NavBarIsVisible="False"
             FlowDirection="LeftToRight"
              xmlns:converters="clr-namespace:loukupm.Converter"
             xmlns:sk="clr-namespace:Maui.Skeleton;assembly=Sharpnado.HorusSkeleton.Maui"
             BackgroundColor="#252525"
             Title="BookingPage">
    <Grid>
        <ScrollView Margin="0,0,0,10">
            <VerticalStackLayout>
                <Grid ColumnDefinitions="*,Auto" HeightRequest="60" BackgroundColor="#202020">
                    <!-- العنوان على اليسار -->
                    <Label Text="Meine Termine"
                           TextColor="White"
                           Margin="24,0,0,0"
                             FontSize="24"
                             FontFamily="georgia-bold"
                             VerticalOptions="Center" />

                    <!-- الزر على اليمين -->
                    <Button Grid.Column="1"
                    WidthRequest="40"
                    HeightRequest="40"
                    CornerRadius="12"
                    ImageSource="backbuttonpmg.png"
                    BackgroundColor="#202020"
                    BorderColor="#999999"
                    Margin="0,0,10,0"            
                    BorderWidth="1"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    Clicked="Button_Clicked_1" />
                </Grid>
                <Frame HeightRequest="150" Margin="20,10,20,0"
                     WidthRequest="350"
                     CornerRadius="16" 
                     BackgroundColor="#444444"
                     sk:Skeleton.IsBusy="{Binding    IsloadBooking}" 
                     sk:Skeleton.Animation="{sk:DefaultAnimation Fade}" 
                     BorderColor="#444444" />

            </VerticalStackLayout>
        </ScrollView>
        <Border Margin="0,0,0,0"
      BackgroundColor="#444444"
      HeightRequest="20"
      VerticalOptions="End" 
      HorizontalOptions="Fill" 
      Stroke="#444444" 
      StrokeShape="RoundRectangle 10,10,0,0" />
    </Grid>
</ContentPage>