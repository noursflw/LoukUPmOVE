<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             xmlns:loc="clr-namespace:loukupm.Langue"
             xmlns:converters="clr-namespace:loukupm.Converter"
             x:Class="loukupm.View.OTPPoneNumper"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             BackgroundColor="Black"
             Title="OTPPoneNumper">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout>
            <Grid>
                <Image Grid.Row="0" Margin="0,100,0,0" WidthRequest="300" HeightRequest="100" Source="slogo.svg"/>
            </Grid>
            <Label Text="{loc:Translate Name=Titelotpphone}" FontFamily="georgia-bold" HorizontalOptions="Center" Margin="20,10,0,0" FontSize="32" TextColor="#D3D3D3" />
            <Label Text="{loc:Translate Name=desotppnone}" FontFamily="georgia-bold" HorizontalOptions="Center" WidthRequest="250" Margin="20,10,0,0" FontSize="16" TextColor="#999999" />
            <HorizontalStackLayout Margin="0,50,0,0" x:Name="PinLayout" Spacing="20" HorizontalOptions="Center">
                <material:TextField
  x:Name="OtpField"
  Keyboard="Numeric"
  
  Text="{Binding Otp, Mode=TwoWay}"
  Margin="0,50,0,0"
  HorizontalOptions="Center"
  WidthRequest="200"/>
            </HorizontalStackLayout>

            <Button  
              Clicked="OnVerifyClicked"
              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
              TextColor="#1F1B04" FontSize="22" FontFamily="georgia-bold"
              WidthRequest="300"
              BorderWidth="1" Text="{loc:Translate Name=standpay}" CornerRadius="16"
              HeightRequest="60" Margin="25,80,25,0" x:Name="VerifyButton" />

            <Button
              x:Name="ResendButton"
              Command="{Binding ResendOtpCommand}"
              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
              Text="{loc:Translate Name=OtpSigninResend}"
              BackgroundColor="Transparent"
              TextColor="#D4AF37"
              FontFamily="georgia-bold"
              FontSize="16"
              BorderWidth="0"
              WidthRequest="300"
              HeightRequest="48"
              Margin="25,12,25,20" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>