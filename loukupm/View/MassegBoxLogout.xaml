
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:Loc="clr-namespace:loukupm.Langue"
    x:Class="loukupm.View.MassegBoxLogout"
    Color="Transparent">

    <Frame
        BackgroundColor="#000"
        CornerRadius="20"
        HasShadow="True"
        Padding="0"
        BorderColor="#F3D97A"
        WidthRequest="320"
        HorizontalOptions="Center"
        VerticalOptions="Center">

        <VerticalStackLayout
            Padding="20"
            Spacing="18"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <Image
                Source="logout1.svg"
                HeightRequest="120"
                Aspect="AspectFit"
                HorizontalOptions="Center" />

            <Label
                Text="{Loc:Translate Name=Logoutmessag}"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                TextColor="White"
                HorizontalTextAlignment="Center" />

            <HorizontalStackLayout
                Spacing="30"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="240">

                <!-- NO -->
                <Button
                    BackgroundColor="#000"
                    Text="{Loc:Translate Name=no}"
                    BorderColor="#D3D3D3"
                    BorderWidth="1"
                    TextColor="White"
                    WidthRequest="100"
                    CornerRadius="10"
                    HeightRequest="44"
                    FontFamily="georgia"
                    Clicked="Button_Clicked_1" />

                <!-- YES -->
                <Button
                    Text="{Loc:Translate Name=yes}"
                    CornerRadius="10"
                    FontFamily="georgia"
                    BackgroundColor="#FF4C4C"
                    BorderColor="#FF4C4C"
                    TextColor="White"
                    HeightRequest="44"
                    WidthRequest="100"
                    Clicked="Button_Clicked" />

            </HorizontalStackLayout>

        </VerticalStackLayout>

    </Frame>

</toolkit:Popup>

