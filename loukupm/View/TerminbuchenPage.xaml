<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="loukupm.View.TerminbuchenPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#252525"
             xmlns:Loc="clr-namespace:loukupm.Langue"
             xmlns:the49="https://schemas.the49.com/dotnet/2023/maui"
             xmlns:sk="clr-namespace:Maui.Skeleton;assembly=Sharpnado.HorusSkeleton.Maui"
             xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             xmlns:converters="clr-namespace:loukupm.Converter"
             Title="TerminbuchenPage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
   
    <ScrollView>
        <VerticalStackLayout>
            <Grid ColumnDefinitions="*,Auto" HeightRequest="60" BackgroundColor="#202020">
                <!-- العنوان على اليسار -->
                <Label Text="{Loc:Translate Name=Booking}"
                       TextColor="White"
                       Margin="24,0,0,0"
                       FontSize="24"
                       FontFamily="georgia-bold"
                       VerticalOptions="Center" />

                <!-- الزر على اليمين -->
                <Button Grid.Column="1"
                    WidthRequest="40"
                    HeightRequest="40"
                    CornerRadius="12"
                    ImageSource="backbuttonpmg.png"
                    BackgroundColor="#202020"
                    BorderColor="#999999"
                    Margin="0,0,10,0"            
                    BorderWidth="1"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    Clicked="Button_Clicked" />
            </Grid>

            <VerticalStackLayout>
                <CollectionView ItemsSource="{Binding services}" IsVisible="{Binding IsCatogory, Converter={StaticResource InverseBoolConverter}}" >
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Margin="24,0,24,0">
                                <Frame BorderColor="#444444" BackgroundColor="#444444" CornerRadius="16" HeightRequest="122" >
                                    <Grid ColumnDefinitions="50*,50*">
                                        <Label  Grid.Column="0" Text="{Binding NameServies}" FontFamily="Oswald" TextColor="#D3D3D3" FontSize="18"  />
                                        <Label  Grid.Column="0" Text="{Binding PriceServies}" Margin="0,30,0,0" FontFamily="Oswald" TextColor="#D3D3D3" FontSize="14"  />
                                        <Label  Grid.Column="0" Text="{Binding TimeServies}" Margin="0,55,0,0" FontFamily="Oswald" TextColor="#D3D3D3" FontSize="14"  />
                                        <Button Grid.Column="1"  TextColor="White" BackgroundColor="Black" WidthRequest="40" FontFamily="Oswald" FontSize="16" ImageSource="exite.svg"  CornerRadius="30"  HeightRequest="40" Margin="122,-40,0,0" />
                                    </Grid>
                                </Frame>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                    <Frame HeightRequest="150" Margin="20,10,20,0"
         WidthRequest="350"
         CornerRadius="16" 
         BackgroundColor="#444444"
         sk:Skeleton.IsBusy="{Binding IsCatogory}" 
         sk:Skeleton.Animation="{sk:DefaultAnimation Fade}" 
         BorderColor="#444444" />


                <Button  Text="{Loc:Translate Name=addservies}" TextColor="White" Clicked="Button_Clicked_2" BackgroundColor="Black" ImageSource="plus.png"  FontFamily="Oswald" FontSize="16"   CornerRadius="16" WidthRequest="286" HeightRequest="48" Margin="-70,15,0,0" />
            </VerticalStackLayout>
            <Label Text="{Loc:Translate Name=hrearchooes}" FontSize="18" TextColor="White" FontFamily="Oswald" Margin="22,10,0,0" />
            <ScrollView Orientation="Horizontal">
                <HorizontalStackLayout>
                    <CollectionView ItemsSource="{Binding WorkTeams}" ItemsLayout="HorizontalList" IsVisible="{Binding IsWorkTeamLoad, Converter={StaticResource InverseBoolConverter}}">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame   BackgroundColor="#202020" BorderColor="#202020" Margin="6">
                                    <VerticalStackLayout  Margin="12">

                                        <ff:CachedImage
                                           WidthRequest="70"
                                           HeightRequest="70"
                                           Aspect="AspectFill"
                                           Margin="0,0,0,20"                
                                           FadeAnimationEnabled="True"
                                           DownsampleToViewSize="True"
                                           LoadingPlaceholder="placeholder.png"
                                           ErrorPlaceholder="placeholder.png"
                                           Source="{Binding ImageSafe}" />
                                        <!-- ملاحظة هنا -->


                                        <Label Text="{Binding Name}" TextColor="#999999" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Frame HeightRequest="150" Margin="20,10,40,0"
                        WidthRequest="132"
                        CornerRadius="16" 
                        BackgroundColor="#444444"
                        sk:Skeleton.IsBusy="{Binding IsWorkTeamLoad}" 
                        sk:Skeleton.Animation="{sk:DefaultAnimation Fade}" 
                        BorderColor="#444444" />
                    <Frame HeightRequest="150" Margin="0,10,40,0"
                      WidthRequest="132"
                      CornerRadius="16" 
                      BackgroundColor="#444444"
                      sk:Skeleton.IsBusy="{Binding IsWorkTeamLoad}" 
                      sk:Skeleton.Animation="{sk:DefaultAnimation Fade}" 
                      BorderColor="#444444" />
 
                </HorizontalStackLayout>
            </ScrollView>
            <Label Text="{Loc:Translate Name=historey}" FontSize="18" TextColor="White" FontFamily="Oswald" Margin="22,10,0,0" />
            <VerticalStackLayout  Padding="10">

                <HorizontalStackLayout VerticalOptions="Start" HorizontalOptions="Fill">

                    <Label x:Name="MonthYearLabel"  Margin="10,0,0,0"
                       FontSize="18" TextColor="#999999" FontFamily="Oswald" 
                       VerticalOptions="Center" HorizontalOptions="CenterAndExpand"/>
                    <Button x:Name="PrevDayButton" 
                 HeightRequest="40" WidthRequest="40"
                 BackgroundColor="#202020" ImageSource="backbuttonpmg.png"
                 CornerRadius="12" Margin="150,0,0,0" BorderColor="#999999" BorderWidth="1"
                 Rotation="180"/>
                    <Button x:Name="NextDayButton" Margin="10,0,0,0"
                    HeightRequest="40" WidthRequest="40"
                   BackgroundColor="#202020" ImageSource="backbuttonpmg.png" 
                    CornerRadius="12" BorderColor="#999999" BorderWidth="1"
                   />
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <CollectionView ItemsSource="{Binding ProviderDays}"
                x:Name="DayCollectionView"
                ItemsLayout="HorizontalList"
                SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Margin="12">
                                    <Frame HeightRequest="86" WidthRequest="86" CornerRadius="16"
                       BackgroundColor="#444444"
                       BorderColor="{Binding BorderColor}">
                                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                            <Label Text="{Binding Date}" TextColor="White" FontSize="16" HorizontalOptions="Center"/>
                                            <Label Text="{Binding Day}" TextColor="White" FontSize="12" HorizontalOptions="Center"/>
                                        </VerticalStackLayout>
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer 
                            Command="{Binding Source={x:Reference DayCollectionView}, Path=BindingContext.SelectDayCommand}"
                            CommandParameter="{Binding}"/>
                                        </Frame.GestureRecognizers>
                                    </Frame>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>


                    <Frame HeightRequest="86" Margin="20,10,40,0"
                   WidthRequest="88"
                    CornerRadius="16" 
                    BackgroundColor="#444444"
                    sk:Skeleton.IsBusy="{Binding allService}" 
                    sk:Skeleton.Animation="{sk:DefaultAnimation Fade}" 
                    BorderColor="#444444" />
                </HorizontalStackLayout>
                <Label Text="{Loc:Translate Name=datebooking}" FontSize="18" TextColor="White" FontFamily="Oswald" Margin="22,10,0,0" />
                <Label Text="{Loc:Translate Name=descrtiondate}" FontSize="14" TextColor="#999999" FontFamily="Oswald" Margin="22,10,0,0" />
                <CollectionView ItemsSource="{Binding WorkTime}" IsVisible="{Binding IsWorkTeamLoad, Converter={StaticResource InverseBoolConverter}}" >
                    <CollectionView.ItemTemplate >
                        <DataTemplate>
                            <HorizontalStackLayout  Margin="20,10,0,0" >
                                <Frame WidthRequest="92" HeightRequest="56" BorderColor="#444444" BackgroundColor="#444444" >
                                    <Label Text="{Binding TimeWork}" Padding="0" Margin="6,-3,0,0" TextColor="White" />
                                </Frame>
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <HorizontalStackLayout>
                    <Frame HeightRequest="56" Margin="20,10,10,0"
                   WidthRequest="92"
                   CornerRadius="16" 
                  BackgroundColor="#444444"
                  sk:Skeleton.IsBusy="{Binding IsWorkTeamLoad}" 
                  sk:Skeleton.Animation="{sk:DefaultAnimation Fade}" 
                 BorderColor="#444444" />
                    <Frame HeightRequest="56" Margin="20,10,10,0"
                       WidthRequest="92"
                       CornerRadius="16" 
                       BackgroundColor="#444444"
                       sk:Skeleton.IsBusy="{Binding IsWorkTeamLoad}" 
                       sk:Skeleton.Animation="{sk:DefaultAnimation Fade}" 
                       BorderColor="#444444" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,Auto" HeightRequest="60">
                <!-- العنوان على اليسار -->
                <VerticalStackLayout Margin="40,0,0,0" >
                    <Label Text="{Loc:Translate Name=invoic}"
                     TextColor="#D3D3D3"
                    Margin="20,0,0,0"
                    FontSize="18"
                   WidthRequest="200"
                   VerticalOptions="Center" />
                    <CollectionView ItemsSource="{Binding InvoiceLoad}" IsVisible="{Binding IsWorkTeamLoad, Converter={StaticResource InverseBoolConverter}}" >
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding TotelInvice}"
                                    TextColor="#D3D3D3"
                                    Margin="24,0,0,0"
                                    FontSize="18" 
                                   VerticalOptions="Center" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Frame HeightRequest="20" Margin="-80,8,0,0"
                        WidthRequest="92"
                        CornerRadius="3" 
                        BackgroundColor="#444444"
                        sk:Skeleton.IsBusy="{Binding InvoiceLoad}" 
                        sk:Skeleton.Animation="{sk:DefaultAnimation Fade}" 
                        BorderColor="#444444" />
                </VerticalStackLayout>
                <!-- الزر على اليمين -->
                <Button Grid.Column="1"
           WidthRequest="192"
           HeightRequest="56"
           FontSize="22"
            TextColor="Black"
           Text="{Loc:Translate Name=bookingNow}"
           CornerRadius="12"
           Margin="0,0,10,10"       
           FontFamily="georgia-bold"
           BorderWidth="1"
           HorizontalOptions="End"
           VerticalOptions="Center"
           Clicked="Button_Clicked_1" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>