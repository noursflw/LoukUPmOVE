<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="loukupm.View.TerminbuchenPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0A0A0A"
             xmlns:Loc="clr-namespace:loukupm.Langue"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:the49="https://schemas.the49.com/dotnet/2023/maui"
             xmlns:sk="clr-namespace:Maui.Skeleton;assembly=Sharpnado.HorusSkeleton.Maui"
             xmlns:ff="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             xmlns:converters="clr-namespace:loukupm.Converter"
             Title="TerminbuchenPage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
            <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
            <converters:BoolToBackgroundColorConverter x:Key="BoolToBackgroundColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
   
    <ScrollView>
        <VerticalStackLayout>
            <Grid ColumnDefinitions="*,Auto" HeightRequest="60" BackgroundColor="#0A0A0A">
               
                <Label Text="{Loc:Translate Name=Booking}"
                       TextColor="White"
                       Margin="24,0,0,0"
                       FontSize="24"
                       FontFamily="georgia-bold"
                       VerticalOptions="Center" />

             
                <Button Grid.Column="1"
                    WidthRequest="40"
                    HeightRequest="40"
                    CornerRadius="12"
                    ImageSource="backbuttonpmg.png"
                    BackgroundColor="#0A0A0A"
                    BorderColor="#999999"
                    Margin="0,0,10,0"            
                    BorderWidth="1"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    Clicked="Button_Clicked" />
            </Grid>

            <VerticalStackLayout Spacing="10" >
                <CollectionView Margin="6" ItemsSource="{Binding SelectedServices}" IsVisible="{Binding IsCatogory, Converter={StaticResource InverseBoolConverter}}" >
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Margin="20,0,20,15" Spacing="0">
                                <Border Margin="0" 
                                        Stroke="#D4AF37" 
                                        StrokeThickness="2" 
                                        BackgroundColor="#2A2A2A" 
                                        StrokeShape="RoundRectangle 16" 
                                        HeightRequest="130" 
                                        Padding="0">
                                    <Grid ColumnDefinitions="100,*,80" RowDefinitions="*" Padding="0" ColumnSpacing="12">
                                        <!-- Service Image -->
                                        <Frame Grid.Column="0" 
                                               Padding="0" 
                                               Margin="12,12,0,12"
                                               CornerRadius="12" 
                                               BackgroundColor="#444444"
                                               BorderColor="#444444"
                                               HasShadow="False"
                                               WidthRequest="90"
                                               HeightRequest="100">
                                            <ff:CachedImage 
                                                Source="{Binding ImageSafe}"
                                                Aspect="AspectFill"
                                                LoadingPlaceholder="imagesafe.png"
                                                ErrorPlaceholder="imagesafe.png" />
                                        </Frame>

                                        <!-- Service Details -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="5" Padding="8,12,0,12" VerticalOptions="Center">
                                            <Label 
                                                Text="{Binding NameServies}" 
                                                FontFamily="Oswald" 
                                                TextColor="White" 
                                                FontSize="16"
                                                FontAttributes="Bold"
                                                LineBreakMode="TailTruncation" />

                                            <Label 
                                                Text="{Binding Category.Name}" 
                                                FontFamily="Oswald" 
                                                TextColor="#999999" 
                                                FontSize="12" 
                                                LineBreakMode="TailTruncation" />

                                            <HorizontalStackLayout Spacing="15" Margin="0,5,0,0">
                                                <HorizontalStackLayout Spacing="3">
                                                    <Label  
                                                        Text="⏱" 
                                                        FontSize="12" 
                                                        TextColor="#D4AF37"
                                                        VerticalOptions="Center" />
                                                    <Label  
                                                        Text="{Binding TimeServies}" 
                                                        FontFamily="Oswald" 
                                                        TextColor="#D3D3D3" 
                                                        FontSize="12" 
                                                        VerticalOptions="Center" />
                                                    <Label 
                                                        Text="Min." 
                                                        FontSize="12"
                                                        TextColor="#D3D3D3"
                                                        VerticalOptions="Center" />
                                                </HorizontalStackLayout>

                                                <HorizontalStackLayout Spacing="3">
                                                    <Label  
                                                        Text="💰" 
                                                        FontSize="12"
                                                        TextColor="#D4AF37"
                                                        VerticalOptions="Center" />
                                                    <Label  
                                                        Text="{Binding PriceServies}" 
                                                        FontFamily="Oswald" 
                                                        TextColor="#D3D3D3" 
                                                        FontSize="12" 
                                                        VerticalOptions="Center" />
                                                    <Label 
                                                        Text="€" 
                                                        FontSize="12"
                                                        TextColor="#D3D3D3"
                                                        VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- Remove Button -->
                                        <VerticalStackLayout Grid.Column="2" 
                                                             Padding="0,12,12,12"
                                                             VerticalOptions="Center"
                                                             HorizontalOptions="Center">
                                            <Button 
                                                ImageSource="Resources/Images/checkeseves.svg"
                                                TextColor="White"
                                                BackgroundColor="Transparent"
                                                BorderColor="#D4AF37"
                                                BorderWidth="1"
                                                WidthRequest="45"
                                                HeightRequest="45"
                                                FontFamily="Oswald"
                                                FontSize="11"
                                                CornerRadius="8"
                                                Padding="0"
                                                Clicked="OnRemoveService" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                    <Frame HeightRequest="150" Margin="20,10,20,0"
         WidthRequest="350"
                           IsVisible="False"
         CornerRadius="16" 
         BackgroundColor="#444444"
         sk:Skeleton.IsBusy="{Binding IsCatogory}" 
         sk:Skeleton.Animation="{sk:DefaultAnimation Fade}" 
         BorderColor="#444444" />


                <Button  Text="{Loc:Translate Name=addservies}" TextColor="White" Clicked="Button_Clicked_2" BackgroundColor="Black" ImageSource="plus.png"  FontFamily="Oswald" FontSize="16"   CornerRadius="16"  HeightRequest="48" VerticalOptions="End" Margin="10" />
            </VerticalStackLayout>
            <Label Text="{Loc:Translate Name=hrearchooes}" FontSize="18" TextColor="White" FontFamily="Oswald" Margin="22,10,0,15" />
            <ScrollView Orientation="Horizontal" Margin="10,0,10,0">
                <CollectionView 
        ItemsSource="{Binding WorkTeams}" 
        x:Name="WorkTeamsCollectionView"
        ItemsLayout="HorizontalList"
        SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame BackgroundColor="#202020" CornerRadius="30" BorderColor="{Binding BorderColor}" Margin="6">
                                <VerticalStackLayout Margin="12" Spacing="8">
                                    <Frame BackgroundColor="#333333" 
                                           WidthRequest="100" 
                                           HeightRequest="100" 
                                           CornerRadius="50"
                                           Padding="0"
                                           BorderColor="#333333"
                                           HasShadow="False">
                                        <ff:CachedImage
                                            WidthRequest="100"
                                            HeightRequest="100"
                                            Aspect="AspectFill"
                                            FadeAnimationEnabled="True"
                                            DownsampleToViewSize="True"
                                            BackgroundColor="#333333"
                                            IsOpaque="False"
                                            Source="{Binding ImageSafe}" />
                                    </Frame>
                                    <Label Text="{Binding Name}" VerticalOptions="Center" HorizontalOptions="Center" TextColor="#999999" FontSize="12" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer 
                                Command="{Binding Source={x:Reference WorkTeamsCollectionView}, Path=BindingContext.SelectWorkTeamCommand}" 
                                CommandParameter="{Binding}" />
                                </Frame.GestureRecognizers>

                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>
            <Label Text="{Loc:Translate Name=historey}" FontSize="18" TextColor="White" FontFamily="Oswald" Margin="22,10,0,0" />
            <VerticalStackLayout  Padding="10">

                <HorizontalStackLayout VerticalOptions="Start" HorizontalOptions="Fill">

                    <Label x:Name="MonthYearLabel"  Margin="10,0,0,0"
                       FontSize="18" TextColor="#999999" FontFamily="Oswald" 
                       VerticalOptions="Center" HorizontalOptions="CenterAndExpand"/>

                </HorizontalStackLayout>
                <CollectionView 
    x:Name="DayCollectionView"
    ItemsSource="{Binding ProviderDays}"
    ItemsLayout="HorizontalList"
    SelectionMode="None"
    HorizontalScrollBarVisibility="Always"
    Margin="10">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <ScrollView>
                                <VerticalStackLayout Margin="6" HorizontalOptions="Start">

                                    <Frame 
HeightRequest="86" 
WidthRequest="86"
CornerRadius="16"
BackgroundColor="#444444"
BorderColor="{Binding BorderColor}"
HasShadow="False">

                                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                            <Label Text="{Binding Date}" 
        TextColor="White" 
        FontSize="16" 
        HorizontalOptions="Center"/>
                                            <Label Text="{Binding Day}" 
        TextColor="White" 
        FontSize="12" 
        HorizontalOptions="Center"/>
                                        </VerticalStackLayout>

                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer 
     Command="{Binding Source={x:Reference DayCollectionView}, Path=BindingContext.SelectDayCommand}" 
     CommandParameter="{Binding}"/>
                                        </Frame.GestureRecognizers>

                                    </Frame>
                                </VerticalStackLayout>
                            </ScrollView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
             
                <Label Text="{Loc:Translate Name=datebooking}" FontSize="18" TextColor="White" FontFamily="Oswald" Margin="22,10,0,0" />
                <Label Text="{Loc:Translate Name=descrtiondate}" FontSize="14" TextColor="#999999" FontFamily="Oswald" Margin="22,10,0,0" />


                <CollectionView x:Name="AvailableSlotsCollectionView"
                                ItemsSource="{Binding AvailableSlots}" 
                                IsVisible="{Binding Isloadday, Converter={StaticResource InverseBoolConverter}}"
                                ItemsLayout="HorizontalList"
                                SelectionMode="None"
                                Margin="10">
                    <CollectionView.ItemTemplate >
                        <DataTemplate>
                            <VerticalStackLayout Margin="6" HorizontalOptions="Start">
                                <Frame WidthRequest="110" 
                                       HeightRequest="60"
                                       BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToBackgroundColorConverter}}"
                                       BorderColor="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}}"
                                       CornerRadius="16"
                                       Padding="0">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer 
                                            Command="{Binding Source={x:Reference AvailableSlotsCollectionView}, Path=BindingContext.SelectSlotCommand}" 
                                            CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>

                                    <Label Text="{Binding DisplayTime}" 
                                           Padding="0" 
                                           Margin="6,-5,0,0"  
                                           TextColor="White" 
                                           FontFamily="Oswald" 
                                           HorizontalTextAlignment="Center" 
                                           VerticalOptions="Center" 
                                           HorizontalOptions="Center" />
                                </Frame>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Label Text="{Loc:Translate Name=notfoundtime}" 
                        FontSize="16" 
                        TextColor="#999999" 
                        FontFamily="Oswald" 
                        Margin="22,17,0,6"
                        HorizontalOptions="Center"
                        IsVisible="{Binding HasAvailabilityError}" />
                <HorizontalStackLayout Margin="10,0,10,0" IsVisible="{Binding Isloadday}">
                    <Frame HeightRequest="56" Margin="6,0,0,0"
             WidthRequest="110"
             CornerRadius="16" 
             BackgroundColor="#444444"
             sk:Skeleton.IsBusy="{Binding Isloadday}" 
             sk:Skeleton.Animation="{sk:DefaultAnimation Fade}" 
             BorderColor="#444444" />
                    <Frame HeightRequest="56" Margin="6,0,0,0"
             WidthRequest="110"
             CornerRadius="16" 
             BackgroundColor="#444444"
             sk:Skeleton.IsBusy="{Binding Isloadday}" 
             sk:Skeleton.Animation="{sk:DefaultAnimation Fade}" 
             BorderColor="#444444" />
                    <Frame HeightRequest="56" Margin="6,0,0,0"
             WidthRequest="110"
             CornerRadius="16" 
             BackgroundColor="#444444"
             sk:Skeleton.IsBusy="{Binding Isloadday}" 
             sk:Skeleton.Animation="{sk:DefaultAnimation Fade}" 
             BorderColor="#444444" />
                </HorizontalStackLayout>
                <Frame BorderColor="#444444" BackgroundColor="#444444" CornerRadius="16" Margin="10" Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Appointment Reminder" 
                               FontSize="16" 
                               TextColor="White" 
                               FontFamily="Oswald" 
                               FontAttributes="Bold" />

                        <Label Text="Select reminder time before appointment" 
                               FontSize="12" 
                               TextColor="#D3D3D3" 
                               FontFamily="Oswald" />

                        <TimePicker Time="{Binding ReminderTime}" 
                                    TextColor="White"
                                    FontFamily="Oswald"
                                    FontSize="14" />

                        <Button Text="Enable Reminder Timer" 
                                TextColor="Black" 
                                BackgroundColor="#FFD700"
                                FontFamily="Oswald" 
                                FontSize="14"
                                CornerRadius="8"
                                Padding="10,8"
                                Command="{Binding EnableReminderTimerCommand}" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,Auto" HeightRequest="60">
              
                <VerticalStackLayout Margin="40,0,0,0" VerticalOptions="Center">
                    <Label Text="{Loc:Translate Name=invoic}"
                     TextColor="#D3D3D3"
                    Margin="20,0,0,0"
                    FontSize="18"
                   WidthRequest="200"
                   VerticalOptions="Center" />
                    
                    <Label Text="{Binding TotalPrice, StringFormat='{0:F2} EUR'}"
                           TextColor="#FFD700"
                           Margin="0,0,10,20"
                           FontSize="18"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                </VerticalStackLayout>
              
                <Button Grid.Column="1"
           WidthRequest="192"
           HeightRequest="56"
           FontSize="22"
            TextColor="Black"
           Text="{Loc:Translate Name=bookingNow}"
           CornerRadius="12"
           Margin="0,0,10,10"       
           FontFamily="georgia-bold"
           BorderWidth="1"
            Command="{Binding PostBookingCommand}"            
           HorizontalOptions="End"
           VerticalOptions="Center"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>