<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="loukupm.View.ChackoutPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#252525"
             xmlns:loc="clr-namespace:loukupm.Langue"
             BackgroundImageSource="baackgroundpage.png"
             Title="ChackoutPage">
    <ScrollView>
        <VerticalStackLayout>
            <Grid>
                <Image Source="checkoutpage.png"/>
                <Image Source="vector.png" HeightRequest="210" />
            </Grid>
            <Label Text="{loc:Translate Name=changvaldechen}" FontFamily="georgia-bold"  FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#D3D3D3" />
            <Label Text="{loc:Translate Name=AcsepPassword}" FontFamily="georgia-bold" HorizontalOptions="Center" VerticalOptions="Center" FontSize="16" TextColor="#999999" />
            <Button  
            Clicked="Button_Clicked"
           TextColor="#1F1B04" FontSize="22" FontFamily="georgia-bold"
      
           BorderWidth="1" Text="{loc:Translate Name=Login}" CornerRadius="16"
           Margin="25,80,25,0"  />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>