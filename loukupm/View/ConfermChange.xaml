<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="loukupm.View.ConfermChange"
             xmlns:Loc="clr-namespace:loukupm.Langue"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">
    <Frame x:Name="PopupCard"
  BackgroundColor="#444444"
  CornerRadius="20"
  HasShadow="True"
  Padding="0"
  BorderColor="#444444"
  WidthRequest="320"
  HorizontalOptions="Center"
  VerticalOptions="Center"
  Opacity="0"
  Scale="0.92">
        <VerticalStackLayout>
            <Frame CornerRadius="20" Margin="0,-8,0,0" Opacity="0.66" BackgroundColor="Transparent" BorderColor="Transparent" >

            </Frame>

            <VerticalStackLayout Margin="0,10,0,0">
                <Image
               Source="vector.png"
               HeightRequest="120"
               Aspect="AspectFit"
               HorizontalOptions="Center"/>
                <Label
            Text="{Loc:Translate Name=ConfermUpateChane}"
               FontAttributes="Bold"
               HorizontalOptions="Center" 
               Margin="0,30,0,0"
               TextColor="White"
              HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
            
        </VerticalStackLayout>

    </Frame>
</toolkit:Popup>