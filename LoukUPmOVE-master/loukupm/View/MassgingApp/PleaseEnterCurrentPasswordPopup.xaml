<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:Loc="clr-namespace:loukupm.Langue"
    x:Class="loukupm.View.MassgingApp.PleaseEnterCurrentPasswordPopup"
     Color="Transparent"
    >

    <Border
        BackgroundColor="#121212"
        Stroke="#444444"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 25"
        WidthRequest="330"
        Padding="25">
        <VerticalStackLayout Spacing="18">
            <Image
            Source="eroref.png"
            HeightRequest="120"
            WidthRequest="200"  
            Aspect="AspectFit"
            HorizontalOptions="Center" />

            <Label
        Text="{Loc:Translate Name=EnterPasswordCeren}"
        TextColor="White"
        FontSize="20"
        HorizontalOptions="Center"/>

            <Border
        BackgroundColor="#1E1E1E"
        Stroke="#555555"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 12">
            </Border>

            <HorizontalStackLayout
        HorizontalOptions="Center"
        Spacing="15">
                <Button
            Text="{Loc:Translate Name=yes}"
                    Clicked="Button_Clicked"
           
            TextColor="White"
            WidthRequest="110"
            CornerRadius="12"/>

            </HorizontalStackLayout>

        </VerticalStackLayout>

    </Border>

</toolkit:Popup>